dfn { background-color: rgba(255, 255, 0, 0); transition: background-color 1s; }

dfn:target { background-color: rgb(255, 255, 0); }

sup { vertical-align: baseline; position: relative; font-size: 0.7em; top: -0.5em; }

sub { vertical-align: bottom; position: relative; bottom: -0.3em; }

.tableau_simple { border-collapse: collapse; }

.tableau_simple td, .tableau_simple th { border: 1px solid rgb(0, 0, 136); padding: 0.5em; }

.notification_text, .notification_text:visited { color: rgb(219, 102, 0); }

.pagination_item { padding: 0px 0.2em; }

.letter-nav { margin-bottom: 1em; }

.letter-nav .letter_separator { display: inline-block; width: 1em; text-align: center; }

h2.letter-header { font-size: 1.2em; border-bottom: 1px solid rgb(221, 221, 221); }

details.details_shim_closed > * { display: none; }

details.details_shim_closed > summary { display: block; }

details.details_shim_open > summary { display: block; }

details.details_shim_closed > summary::before { display: inline-block; content: "+"; width: 1.3em; height: 0.8em; background: rgb(0, 0, 136); color: white; text-align: center; font-weight: bold; margin-right: 1em; padding-bottom: 0.5em; }

details.details_shim_open > summary::before { display: inline-block; content: "-"; width: 1.3em; height: 0.8em; background: rgb(0, 0, 136); color: white; text-align: center; font-weight: bold; margin-right: 1em; padding-bottom: 0.5em; }

blockquote { color: rgb(102, 102, 102); background: rgb(238, 238, 238); margin: 0px 0px 0.8em; padding: 1rem 0.5em 0.5em 1.7rem; border-radius: 0.5em; min-height: 1.5em; max-height: 20em; overflow: auto; position: relative; }

blockquote img { opacity: 0.7 !important; }

blockquote blockquote { border: 1px solid rgb(204, 204, 204); max-height: none; }

blockquote cite { display: block; font-size: 1em; color: rgb(102, 102, 102); margin: 0px; padding: 0px; font-weight: bold; font-style: normal; }

blockquote::before { content: "â€œ"; position: absolute; color: rgb(102, 102, 102); font-size: 2em; font-weight: bold; vertical-align: middle; margin: -0.5rem 0.1rem 0px -1.2rem; }

select, input, textarea { font-size: 1rem; accent-color: rgb(0, 0, 136); color: rgb(0, 0, 0); }

input[readonly="readonly"] { color: rgb(136, 136, 136); }

.form input[type="text"], .form input[type="email"], .form input[type="password"], .form input[type="tel"], .form input[type="url"], .form input[type="number"], .form input[type="date"], .form select, .form textarea { padding: 0.2em; width: 15rem; box-sizing: border-box; }

input[type="radio"], input[type="checkbox"] { margin-left: 0px; }

button, input[type="submit"], input[type="button"], a.button, .button { border: 1px solid rgb(0, 0, 136); padding: 0.2em 0.8em; border-radius: 0.5em; background: rgb(0, 0, 136); color: rgb(255, 255, 255); cursor: pointer; font-size: 1em; font-weight: bold; text-decoration: none; appearance: none; }

button:focus, input[type="submit"]:focus, input[type="button"]:focus, a.button:focus, .button:focus { outline-color: rgb(245, 114, 0); }

button.secondary, input[type="submit"].secondary, input[type="button"].secondary, a.button.secondary, .button.secondary { background: rgb(255, 255, 255); color: rgb(0, 0, 136); }

button[disabled], input[type="submit"][disabled], input[type="button"][disabled], .button[disabled], .button.disabled, .button.secondary.disabled { border-color: rgb(102, 102, 102); background: rgb(238, 238, 238); cursor: default; color: rgb(102, 102, 102) !important; }

button[disabled] img, .button[disabled] img, .button.disabled img { filter: invert(0.8); }

button[disabled] img[src$="svg"], .button[disabled] img[src$="svg"], .button.disabled img[src$="svg"] { filter: grayscale(1) contrast(0); }

input[type="file"]::-webkit-file-upload-button { border: 1px solid rgb(0, 0, 136); padding: 0.2em 0.5em; border-radius: 0.5em; background: rgb(255, 255, 255); color: rgb(0, 0, 136); cursor: pointer; font-size: 1em; font-weight: bold; text-decoration: none; }

input[type="file"]::file-selector-button { border: 1px solid rgb(0, 0, 136); padding: 0.2em 0.5em; border-radius: 0.5em; background: rgb(255, 255, 255); color: rgb(0, 0, 136); cursor: pointer; font-size: 1em; font-weight: bold; text-decoration: none; }

fieldset { position: relative; border: 1px solid rgb(204, 204, 204); border-radius: 0.5em; padding: 0.8em; margin: 0px 0px 1em; min-width: 0px; overflow-x: auto; }

fieldset legend { font-weight: bold; color: rgb(0, 0, 136); padding: 0px 0.2rem; font-size: 1.2em; left: 0px; }

.form fieldset dl { display: grid; grid-template-columns: 12em auto; margin: 0.2em; }

.form fieldset dt { margin: 0px 0.5em 0.5em 0px; }

.form fieldset dd { margin: 0px 0px 0.5em; }

@media (max-width: 600px) {
  .form fieldset dl { grid-template-columns: auto; margin-top: -0.8em; }
  .form fieldset dt { margin: 0.5em 0px 0px; }
  .form fieldset dd { margin: 0px; }
}

.form .valider { text-align: center; padding-top: 0.8em; }

.form .valider input { font-size: 100%; }

.multi_select { position: relative; display: inline-block; width: 15rem; vertical-align: bottom; margin-bottom: -0.3em; }

.multi_select > ul { position: absolute; background: rgb(255, 255, 255); border-width: 1px; border-color: rgb(128, 128, 128); border-image: none; border-style: none solid solid; padding: 0.2em 0.5em 0.1em 0.3em; font-size: 90%; width: 100%; box-sizing: border-box; z-index: 100; max-height: 15em; overflow: auto; top: 1.8em; }

.multi_select ul { list-style-type: none; }

.multi_select_open { display: block; }

.multi_select_closed { display: none; }

.multi_select li { margin: 0px; }

.multi_select ul ul { margin-left: 1em; }

.multi_select input { margin-left: 0px; }

.multi_select_button { display: inline-block; background: rgb(255, 255, 255); border: 1px solid rgb(128, 128, 128); width: 100%; text-align: left; font-size: 90%; padding: 0.2em; box-sizing: border-box; cursor: default; text-overflow: ellipsis; white-space: nowrap; overflow: hidden; }

.multi_select ~ .button.secondary { margin-left: 0.3em; padding: 0.1em 0.8em !important; }

.simple_form { background: rgb(223, 238, 251); border-radius: 0.5em; margin: 0px -1em 1em; padding: 1em; display: grid; grid-template-columns: min-content auto min-content auto; gap: 0.5em; align-items: center; }

.simple_form.form_1_col { grid-template-columns: auto; }

.simple_form.form_2_cols { grid-template-columns: min-content auto; width: max-content; box-sizing: border-box; margin: 0px auto 1em; }

.simple_form .legend { grid-column: 1 / -1; font-weight: bold; color: rgb(0, 0, 136); }

.simple_form .submit { grid-column: 1 / -1; text-align: center; padding-top: 0.5em; }

.simple_form:not(.form_1_col) label { white-space: nowrap; }

.simple_form .long_field { grid-column: 2 / -1; }

.simple_form .long_field input { width: 100% !important; }

.sort_selection { float: right; clear: right; padding-right: 0.1em; padding-bottom: 0.5em; }

.sort_selection select { width: auto; }

@media (max-width: 1235px) {
  .simple_form { border-radius: 0px 0.5em 0.5em 0px; }
  .simple_form.form_2_cols { border-radius: 0.5em; }
}

@media (max-width: 950px) {
  .simple_form { border-radius: 0px; }
}

@media (max-width: 900px) {
  .simple_form { grid-template-columns: min-content auto; }
  .simple_form .long_field input { width: 15rem !important; }
}

@media (max-width: 600px) {
  .simple_form.form_2_cols { width: auto; margin: 0px -1em 1em; box-sizing: content-box; border-radius: 0px; }
}

@media (max-width: 450px) {
  .simple_form, .simple_form.form_2_cols { grid-template-columns: auto; row-gap: 0.2em; }
  .simple_form > div:nth-child(2n) { margin-bottom: 0.3em; }
  .simple_form .long_field { grid-column: 1 / -1; }
  .sort_selection { float: none; }
  .simple_form.form_2_cols .submit { text-align: center; }
  .simple_form.form_2_cols > label { font-weight: bold; margin-top: 0.3em; }
  .simple_form.form_2_cols input[type="text"], .simple_form.form_2_cols input[type="email"], .simple_form.form_2_cols input[type="password"], .simple_form.form_2_cols select { width: 100%; }
}

.sprite { background-position: 0px 0px; width: 16px; height: 16px; display: inline-block; margin: 0px 0px -3px; print-color-adjust: exact; }

[role="tablist"] { margin-bottom: -1px; }

[role="tab"] { position: relative; padding: 0px 0.2em; background: rgb(255, 255, 255); border-width: 1px 1px 0px; border-style: solid solid none; border-color: rgb(204, 204, 204) rgb(204, 204, 204) currentcolor; border-image: none; border-radius: 0.2em 0.2em 0px 0px; margin-right: 0.5em; color: rgb(0, 0, 0); font-weight: normal; z-index: 1; }

[role="tabpanel"] { position: relative; padding: 0.2em; border: 1px solid rgb(204, 204, 204); border-radius: 0px 0.2em 0.2em; z-index: 2; }

[role="tab"][aria-selected="true"] { z-index: 3; }

.error_box, .warning_box, .info_box { background: rgb(255, 217, 217); padding: 1em; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 0.5em; margin: 0px -1em 1.5em; }

@media (max-width: 1235px) {
  .error_box, .warning_box, .info_box { border-radius: 0px 0.5em 0.5em 0px; }
}

@media (max-width: 950px) {
  .error_box, .warning_box, .info_box { border-radius: 0px; }
}

.warning_box { background: rgb(255, 226, 194); }

.info_box { background: rgb(223, 238, 251); }

.error_box legend, .warning_box legend, .info_box legend { color: rgb(136, 0, 0); font-weight: bold; background: rgb(255, 255, 255); padding: 0px 0.5em 0.2em; border-radius: 0.5em; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

@media print {
  .error_box, .warning_box, .info_box { border: 1px solid rgb(0, 0, 136); }
}

.bulle_aide { z-index: 100000; display: none; position: absolute; width: 20em; margin: 0.5em 0px 0px; padding: 0.3em; background: rgb(251, 237, 223); border: 1px solid rgb(204, 204, 204); box-shadow: rgb(170, 170, 170) 1px 1px 3px; }

.bulle_aide h3 { margin: 0px; padding: 0px; }

.tooltip { display: none; position: absolute; z-index: 2000; max-width: 350px; min-width: 200px; background: rgb(251, 237, 223); padding: 0.4em; border-radius: 0.5em; box-shadow: rgb(170, 170, 170) 2px 2px 3px; }

.tooltip::before { content: ""; display: block; position: absolute; width: 0px; height: 0px; border-left: 1em solid transparent; border-right: 1em solid transparent; border-bottom: 1em solid rgb(251, 237, 223); top: -1em; left: var(--pointerPositionX, 1em); }

.thumbnail { position: absolute; display: inline-block; z-index: 2000; margin: 20px 0px 0px 10px; padding: 3px; border: 1px solid rgb(204, 204, 204); box-shadow: rgb(170, 170, 170) 3px 3px 5px; background: url("chargement.gif") 60px 60px no-repeat rgb(255, 255, 255); min-height: 135px; min-width: 135px; }

.thumbnail.loaded { background: rgb(255, 255, 255); }

.thumbnail img { max-height: 135px; width: auto; height: auto; vertical-align: top; max-width: 270px !important; }

.thumbnail_opener { width: 16px; height: 16px; vertical-align: -3px; color: rgb(102, 102, 102); cursor: default; }

a[data-zoompic] { cursor: zoom-in; }

#zoomedPic { display: none; width: 100vw; height: 100vh; position: fixed; top: 0px; left: 0px; z-index: 3000; cursor: zoom-out; }

#zoomedPic #zoomedMain { width: 100vw; height: 100vh; position: absolute; display: flex; align-items: center; justify-content: center; background-color: rgba(255, 255, 255, 0.85); }

#zoomedContent { text-align: center; }

#zoomedPic img { max-width: 90vw; max-height: 90vh; margin: 1em; }

#zoomedPic .pdf_thumbnail img { background: rgb(255, 255, 255); box-shadow: rgb(204, 204, 204) 0px 0px 0.5em; position: relative; display: block; }

#zoomedContent .pdf_thumbnail { display: block; position: relative; }

#zoomedContent .pdf_thumbnail::after { position: absolute; display: block; content: ""; z-index: 1; background-image: url("pdf.svg"); background-size: 4em 4em; width: 4em; height: 4em; bottom: -0.5em; right: 0px; }

#zoomedPic button { background: rgb(223, 238, 251); text-align: center; padding: 0.7em 1em; border-radius: 2em; font-weight: bold; cursor: pointer; text-decoration: none; color: rgb(0, 0, 0); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

@media (max-width: 700px) {
  #zoomedPic button { position: absolute; }
  #zoomedPic .prev_pic_btn { top: 1em; left: 1.5em; }
  #zoomedPic .next_pic_btn { top: 1em; right: 1.5em; }
  #zoomedPic img { max-width: 95vw; }
}

