------MultipartBoundary--mw4RnG0WjxBtwA7riuhKi1Fi1S0m9Wp2hBbHVrj35w----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://en.numista.com/design/catalogue.v768.css

@charset "utf-8";

#country_intro, .long_text { margin: 0.5em 0px 1em; overflow: hidden; position: relative; transition: max-height 1s ease-out; }

#country_intro_ellipsis, .long_text_ellipsis { background: white; color: rgb(0, 0, 136); position: absolute; right: 0px; top: 1.5em; font-size: 0.9em; font-weight: normal; padding: 0px 0.5em; }

#country_intro_ellipsis::before, .more_example_details::before, .long_text_ellipsis::before { content: " "; display: block; background-image: url("data:image/png;base64,"); width: 30px; height: 1.2em; position: absolute; top: 0.2em; left: -31px; }

p.related_links { color: rgb(85, 85, 85); font-style: italic; max-width: 50em; }

p.related_links:last-of-type { margin-bottom: 1em; }

.catalogue_search_results { margin: 1em 0px; max-width: 50em; }

.catalogue_search_results header { margin-bottom: 0.3em; }

.catalogue_search_results header h2 { margin: 1em 0px 0px; font-size: 1.3em; }

.catalogue_search_results header p { }

.catalogue_search_results > div { min-height: 135px; display: flex; padding: 0.5em 0px; border-top: 1px solid rgb(204, 204, 204); }

.catalogue_search_results .photo_avers, .catalogue_search_results .photo_revers { width: 135px; height: 135px; margin: 0px 1em 0px 0px; flex-shrink: 0; }

.catalogue_search_results .description_piece { flex-grow: 1; }

.catalogue_search_results .coin_status { float: right; margin-left: 0.5em; }

@media (max-width: 600px) {
  .catalogue_search_results > div { flex-wrap: wrap; }
  .catalogue_search_results .photo_avers, .catalogue_search_results .photo_revers { max-width: 49%; margin-right: 0px; height: auto; }
  .catalogue_search_results .description_piece { width: 100%; margin: 0.3em 0px 0px; }
}

.catalogue_search { padding: 1em; margin: 0px -1em 1.5em; border-radius: 0.5em; background: url("search-background.jpg") center top rgb(231, 242, 252); }

.catalogue_search_sets { padding: 1em; margin: 0px -1em 1.5em; border-radius: 0.5em; background: url("search-background-set.jpg") center center rgb(231, 242, 252); }

@media (max-width: 1235px) {
  .catalogue_search { border-radius: 0px 0.5em 0.5em 0px; }
}

@media (max-width: 950px) {
  .catalogue_search { border-radius: 0px; }
}

.catalogue_search .search_box { margin-bottom: 0.5em; }

.search_box select { width: 15em; border: 1px solid rgb(0, 0, 136); border-radius: 0.5rem; }

.search_box .catalogue_search_input_wrapper { flex-grow: 1; max-width: 30em; margin: 0px 0.5em; position: relative; }

.search_box .catalogue_search_input_wrapper input[type="text"] { width: 100%; height: 100%; border: 1px solid rgb(0, 0, 136); border-radius: 0.5em; padding-right: 3.8em; }

.search_box #special_keyboard_button { display: block; position: absolute; top: 0.3em; right: 2.2em; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; }

.search_box #special_keyboard_button img { width: 1.2em; height: 1.2em; vertical-align: bottom; }

#special_keyboard { transition: 0.25s ease-in-out; max-height: 0px; overflow: hidden; background: rgba(255, 255, 255, 0.533); padding: 0px 1em; border-radius: 0.5em; }

#special_keyboard[aria-hidden="false"] { max-height: 40em; padding: 1em; }

#alphabets_r { background: rgb(255, 255, 255); max-width: 34em; }

.search_box .catalogue_search_input_wrapper > img { display: block; position: absolute; top: 0.4em; right: 0.5em; }

.search_box .select2-container--default .select2-selection--single { border: 1px solid rgb(0, 0, 136); border-radius: 0.5rem; height: 100%; }

.search_box .select2-container--default .select2-selection--single { border: 1px solid rgb(0, 0, 136); border-radius: 0.5rem; }

.search_box .select2-container--default .select2-selection--single .select2-selection__placeholder { color: rgb(0, 0, 0); }

.search_criteria { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5em; margin-top: 0.5em; }

.search_criteria[aria-hidden="true"] { display: none; }

.search_criteria > div { border: 1px solid rgb(170, 170, 170); border-radius: 1em; padding: 0.2em 0.2em 0.2em 0.5em; background: white; }

.search_criteria > div button { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; font-weight: bold; padding: 0px 0.5em 0px 0.3em; background: rgb(255, 255, 255); color: rgb(0, 0, 136); }

.search_criteria > button { display: inline-block; vertical-align: middle; border-radius: 1em; padding: 0.2em 0.5em; }

.search_criteria .criteria_im1 *, .search_criteria .criteria_im2 * { vertical-align: middle; }

.search_criteria .image_filter { height: 3.5em; width: auto; }

#search_filters { transition: 0.25s ease-in-out; overflow: hidden; max-height: 100em; display: grid; grid-template-columns: max-content auto max-content auto; background: rgba(255, 255, 255, 0.533); padding: 1em 1em 0.5em; margin-top: 1em; border-radius: 0.5em; position: relative; }

#search_filters[aria-hidden="true"] { display: none; }

#search_filters input[type="text"], #search_filters select, #search_filters .multi_select { width: 12em; max-width: 100%; box-sizing: border-box; }

#search_filters > .label { padding: 0px 1em 0.5em 0px; }

#search_filters > .label:nth-child(4n+3) { padding: 0px 1em 0.5em 1.5em; }

#search_filters > div { padding: 0px 0px 0.5em; }

#search_filters > div > label { white-space: nowrap; }

#search_filters .search_ref select { width: 5.5em; margin-right: 0.2em; }

#search_filters .search_ref .select2 { vertical-align: top; margin-right: 0.2em; }

#search_filters .search_ref input[type="text"] { width: 6.3em; }

@media (max-width: 800px) {
  #search_filters { grid-template-columns: max-content auto; }
  #search_filters > .label { padding: 0px 1em 0.5em 0px; }
  #search_filters > .label:nth-child(4n+3) { padding: 0px 1em 0.5em 0px; }
}

@media (max-width: 450px) {
  #search_filters { grid-template-columns: auto; }
  #search_filters > .label { padding: 0px 0px 0.1em; }
  #search_filters > .label:nth-child(4n+3) { padding: 0px 0px 0.1em; }
}

#search_filters > button { display: block; position: absolute; right: 0px; bottom: 0px; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0.2em; }

#search_filters > button img { height: 1em; width: 1em; }

.image_button img { vertical-align: middle; }

.image_button[disabled] img { filter: none; }

.image_button[disabled] img[src$="picture.svg"] { filter: invert(0.5); }

.image_button img[src$="chargement.gif"] { margin: 0px 1px; }

#pinned_picture_label span { height: 100%; display: flex; align-items: center; }

#pinned_picture_label { grid-column: 1; padding-left: 0px !important; }

#pinned_picture_display { grid-column: 2 / -1; }

#catalogue_index_link { margin: -0.5em 0px 1em; }

#catalogue_index_link span { display: inline-block; }

#catalogue_index_link span { margin-right: 2em; }

#catalogue_index_link span:last-child { margin-right: 0px; }

.shape_with_icon { display: flex; align-items: center; }

.shape_with_icon img { width: 1.5em; height: 1.5em; margin-right: 0.3em; }

.script_option .example { color: rgb(113, 113, 159); padding-left: 0.5em; }

#catalogue_home_links { display: flex; flex-wrap: wrap; position: relative; margin-right: -1em; justify-content: center; }

#catalogue_home_links a { background:  0% 0% / cover rgb(238, 238, 238); border-radius: 0.5em; padding: 1em; display: flex; justify-content: center; align-items: center; width: calc(25% - 1em); box-sizing: border-box; margin-right: 1em; margin-bottom: 1em; height: 5em; font-weight: bold; font-size: 1.2em; text-shadow: rgb(255, 255, 255) 2px 0px 8px, rgb(255, 255, 255) -2px 0px 8px, rgb(255, 255, 255) 0px 2px 8px, rgb(255, 255, 255) 0px -2px 8px; text-align: center; }

@media (min-width: 950px) {
  #catalogue_home_links { margin-right: -2em; }
}

@media (min-width: 1235px) {
  #catalogue_home_links { margin-left: -1em; }
  #catalogue_home_links a { height: 6em; }
}

@media (max-width: 600px) {
  #catalogue_home_links a { width: calc(33% - 1em); }
}

@media (max-width: 480px) {
  #catalogue_home_links a { width: calc(50% - 1em); }
}

#catalogue_home_links .catalogue_home_issuers { background-image: url("catalogue_home_issuers.jpg"); }

#catalogue_home_links .catalogue_home_mints { background-image: url("catalogue_home_mints.jpg"); }

#catalogue_home_links .catalogue_home_printers { background-image: url("catalogue_home_printers.jpg"); }

#catalogue_home_links .catalogue_home_artists { background-image: url("catalogue_home_artists.jpg"); }

#catalogue_home_links .catalogue_home_rulers { background-image: url("catalogue_home_rulers.jpg"); }

#catalogue_home_links .catalogue_home_issuing_entities { background-image: url("catalogue_home_issuing_entities.jpg"); }

#catalogue_home_links .catalogue_home_catalogues { background-image: url("catalogue_home_catalogues.jpg"); }

#catalogue_home_links .catalogue_home_techniques { background-image: url("catalogue_home_techniques.jpg"); }

#catalogue_home_links .catalogue_home_edges { background-image: url("catalogue_home_edges.jpg"); }

#catalogue_home_links .catalogue_home_shapes { background-image: url("catalogue_home_shapes.jpg"); }

#catalogue_home_links .catalogue_home_tags { background-image: url("catalogue_home_tags.jpg"); }

#catalogue_home_links .catalogue_home_materials { background-image: url("catalogue_home_materials.jpg"); }

#catalogue_home_links .catalogue_home_types { background-image: url("catalogue_home_types.jpg"); }

#catalogue_home_links .catalogue_home_calendars { background-image: url("catalogue_home_calendars.jpg"); }

#catalogue_home_links .catalogue_home_sets { background-image: url("catalogue_home_sets.jpg"); }

.catalogue_chapter_list { float: left; max-width: 25em; max-height: 8em; overflow: auto; border-radius: 0.5em; padding: 0.5em 0.5em 0.3em; margin: 0px 1em 1em 0px; border: 1px solid rgb(170, 170, 170); }

.catalogue_chapter_list li { margin-bottom: 0.2em; }

.country_links { margin: 1em 0px; display: flex; flex-wrap: wrap; align-items: center; }

.country_links a { padding: 0px 0.5em; }

.country_links a::before { content: " "; display: inline-block; width: 20px; height: 17px; background: url("icons-sprite36.png") no-repeat; print-color-adjust: exact; margin: 0px 0.5em -2px 0px; }

.country_links a.country_coin::before { background-position: -40px -21px; }

.country_links a.country_banknote::before { width: 17px; background-position: -175px -151px; }

.country_links a.country_exonumia::before { width: 21px; background-position: -141px -22px; }

.country_links a.country_swap::before { background-position: -60px -22px; }

.country_links a.country_buy::before { background-position: -117px -78px; }

@media (max-width: 400px) {
  .country_links { flex-direction: column; align-items: flex-start; }
  .country_links a { padding: 0px 0px 0.3em; }
}

.catalogue_navigation { clear: both; margin: 1em 0px; max-width: 50em; }

#results_options_switch { float: right; }

#results_options { padding-left: 1em; transition: max-height 0.5s ease-out; overflow: hidden; }

.liste_pays, .liste_subtypes { list-style-type: none; column-count: 3; }

.liste_pays ul, .liste_subtypes ul { list-style-type: none; padding-left: 0.5em; margin-left: 0.5em; border-left: 1px solid rgb(170, 170, 170); }

.liste_pays li, .liste_subtypes li { margin: 0px; break-inside: avoid-column; }

.liste_pays .historical_period { font-style: italic; }

.country_nomatch { display: none; }

.shortcut_icon { width: 0.8em; height: 0.8em; vertical-align: bottom; margin: 0px 0px 0.2em 0.2em; }

.liste_pays .alt_names { display: none; }

.liste_pays summary { color: rgb(102, 102, 102); margin-left: 1em; }

.liste_pays summary::before { font-size: 0.9em; }

.liste_subtypes h3 { margin: 0px 0px 0.1em; font-size: 1.1em; }

.liste_subtypes > li { padding-bottom: 1em; }

#country_filters > div { display: flex; gap: 1em; margin-bottom: 1.5em; }

#country_filters > div > label { width: 50%; display: flex; gap: 0.5em; align-items: center; }

#country_filters > div > label > select, #country_filters > div > label > input, #country_filters > div > label > span { height: 32px; min-height: 32px; box-sizing: border-box; flex: 1 1 0%; }

@media (max-width: 900px) {
  .liste_pays, .liste_subtypes { column-count: 2; }
  #country_filters > div { flex-direction: column; gap: 0.2em; }
  #country_filters > div > label { flex-direction: column; gap: 0px; width: 100%; align-items: flex-start; }
  #country_filters > div > label > select, #country_filters > div > label > input, #country_filters > div > label > span { width: 100% !important; }
}

@media (max-width: 600px) {
  .liste_pays, .liste_subtypes { column-count: 1; }
  .liste_pays li, .liste_subtypes li { padding: 0.8em 0px 0px; }
  #country_filters > div { grid-template-columns: auto; }
  #country_filters > div label { grid-row-start: auto; }
  #country_filters > div label:nth-child(3) { margin-top: 0.5em; }
}

@media (-ms-high-contrast: none), (-ms-high-contrast: active) {
  #country_filters > div label:nth-child(3) { margin: 0.5em 0px 0px; }
}

.liste_pays.geographical_issuers, .liste_pays.alphabetical_issuers.filtered { column-count: 1; }

.liste_pays.geographical_issuers summary { color: inherit; margin: 0px 0px 0.3em; }

.liste_pays.geographical_issuers summary::before { display: none; }

.liste_pays.geographical_issuers summary::after { content: "â–¶"; font-size: 0.8em; color: rgb(102, 102, 102); margin-left: 0.5em; }

.liste_pays.geographical_issuers details:open summary::after { content: "â–¼"; }

#fiche_photo { float: left; padding: 0px 1em 1em 0px; width: 50%; box-sizing: border-box; }

#fiche_photo .coin_pic { display: inline-block; max-width: 180px; vertical-align: middle; }

@media (max-width: 1080px) {
  #fiche_photo .coin_pic { max-width: calc(50% - 0.5em); }
}

#fiche_photo .coin_pic img { max-height: 180px; }

#fiche_photo .coin_pic:first-child { margin-right: 1em; }

.paper_photo img { box-shadow: rgba(0, 0, 0, 0.5) 0px 0px 0.3em 0px; }

.mentions { font-size: 0.9em; max-width: 25em; }

.mentions a { color: black; }

.caracteristiques_wrapper { float: right; max-width: calc(50% - 0.5em); margin-left: 0.5em; }

#fiche_caracteristiques { background: rgb(223, 238, 251); padding: 1em; border-radius: 0.5em; margin-bottom: 1em; box-sizing: border-box; }

#fiche_caracteristiques h3 { text-align: center; margin: 0px 3.5em 0.5em 0.5em; }

#fiche_caracteristiques th { text-align: left; vertical-align: top; line-height: 1em; padding: 0.2em 0.5em 0.2em 0px; }

#fiche_caracteristiques td { line-height: 1em; padding: 0.2em 0px; }

#call_to_action_buttons { display: flex; gap: 1em; margin: 0px 0px 1em; align-items: stretch; }

#call_to_action_buttons a { flex: 1 1 0%; border: 1px solid rgb(172, 210, 245); border-radius: 0.5em; padding: 0.5em; display: flex; gap: 0.5em; text-align: center; justify-content: center; }

#call_to_action_buttons a > * { align-self: center; }

.fiche_catalogue { border-bottom: 1px dotted rgb(136, 136, 136); white-space: nowrap; color: rgb(0, 0, 0) !important; }

.catalogue_tooltip img { float: right; max-width: 80px; max-height: 120px; width: auto; height: auto; margin: 0px 0px 0.2em 0.3em; }

#fiche_descriptions { clear: left; overflow-wrap: break-word; }

#fiche_descriptions p { margin-bottom: 0.5em; }

.lettering { font-variant-emoji: text; }

.engraver_link { color: black; border-bottom: 1px dashed rgb(102, 102, 102); cursor: help; }

#fiche_mint { border-collapse: collapse; }

#fiche_mint td { padding: 0px 0.5em 0px 0px; vertical-align: top; }

#fiche_mint td:empty { padding-right: 0px; }

#fiche_mint img { margin: 0.2em 0px 0.5em; }

.mintmark_pic { max-width: 50px; max-height: 50px; width: auto; }

#fiche_signatures { border-collapse: collapse; }

#fiche_signatures td { padding-right: 1em; vertical-align: middle; }

.signature_picture { max-height: 2em; }

#fiche_marks td { padding-right: 0.5em; vertical-align: top; }

#fiche_comments { word-break: break-word; transition: height 1s; overflow: hidden; position: relative; }

#fiche_comments.collapsed::before { content: " "; display: block; position: absolute; bottom: 0px; height: 30px; width: 100%; background: url("ellipsis-vertical-large.png") repeat-x; }

.tag_list { list-style-type: none; margin-bottom: 0.5em; }

.tag_list::before, .tag_hash::before { content: "#"; font-family: arial, sans-serif; color: rgb(0, 0, 136); font-size: 120%; }

.tag_list li, #tags strong { display: inline-block; margin: 0px 0.3em; padding: 0.1em 0.8em; background: rgb(223, 238, 251); border-radius: 0.3em; transform: skew(-20deg, 0deg); }

.tag_list a, #tags strong a { display: inline-block; transform: skew(20deg, 0deg); color: rgb(0, 0, 136); }

.swapper_list::before { content: ""; display: inline-block; width: 20px; height: 17px; margin: 0px 0px -2px; background: url("icons-sprite36.png") -60px -22px no-repeat; print-color-adjust: exact; }

#sale_offers, #sale_offers_greysheet { position: relative; }

#sale_offers .buy_coin_links, #sale_offers_greysheet .buy_coin_links { display: flex; padding-top: 1em; margin: 0.5em 0px 0.5em -0.5em; overflow-x: auto; }

#sale_offers .buy_coin_links > div, #sale_offers_greysheet .buy_coin_links > div { width: 160px; min-width: 160px; margin: 0px 0.5em; padding-bottom: 2em; }

#sale_offers .buy_coin_links > div p, #sale_offers_greysheet .buy_coin_links > div p { text-align: left; left: 0.1em; }

#sale_offers .item_price, #sale_offers_greysheet .item_price { position: absolute; width: calc(100% - 0.6em); bottom: 0.3em; }

#sale_offers .buy_spacer, #sale_offers_greysheet .buy_spacer { min-width: 30px; margin-left: -0.5em; }

#sale_offers::after, #sale_offers_greysheet::after { content: " "; background: url("ellipsis.png") repeat-y; width: 30px; height: 100%; position: absolute; top: 0px; right: 0px; }

#sale_offers .promo_details, #sale_offers_greysheet .promo_details { color: rgb(0, 0, 136); font-size: 0.9em; }

#sale_offers .disclaimer, #sale_offers_greysheet .disclaimer { color: rgb(119, 119, 119); font-size: 0.9em; font-style: italic; margin-top: 0.5em; }

#sale_offers:has(+ #sale_offers_greysheet:not(:empty)) .disclaimer { display: none; }

#sale_offers:has(+ #sale_offers_greysheet:not(:empty)) { margin-bottom: 1em; }

.own_stat { text-align: center; }

.own_stat span::before { content: ""; width: 7px; height: 7px; display: inline-block; border-radius: 7px; margin: 0px 0.2em 1px 0px; }

.own_stat span.cluster1::before { background: rgb(254, 229, 217); }

.own_stat span.cluster2::before { background: rgb(252, 174, 145); }

.own_stat span.cluster3::before { background: rgb(251, 106, 74); }

.own_stat span.cluster4::before { background: rgb(222, 45, 38); }

.own_stat span.cluster5::before { background: rgb(165, 15, 21); }

@media (max-width: 700px) {
  #fiche_photo { float: none; margin-right: 0px; padding-right: 0px; width: auto; }
  #fiche_caracteristiques { background: none; padding: 0px; }
  .caracteristiques_wrapper { float: none; max-width: none; margin: 0px; }
  #fiche_caracteristiques h3 { text-align: left; margin: 1em 0px 0.5em; }
}

@media (max-width: 350px) {
  #fiche_photo .coin_pic { max-width: 50%; }
  #fiche_photo .coin_pic:first-child { margin: 0px; }
}

#examples_list { display: grid; grid-template-columns: repeat(3, 17em); gap: 10px; }

#examples_list > div { border: 1px solid rgb(204, 204, 204); border-radius: 10px; padding: 2px 10px; display: flex; flex-direction: column; justify-content: space-between; position: relative; }

.example_image { max-width: 16em; width: 100%; height: 7em; overflow: hidden; white-space: nowrap; }

.example_image img { height: 7em; width: auto; max-width: none; vertical-align: bottom; }

.example_description { height: 4em; overflow: hidden; position: relative; }

.example_comment { margin-top: 0.5em; position: relative; }

.example_comment_card { font-size: smaller; position: relative; }

.more_example_details { display: none; position: absolute; bottom: 0px; right: 0px; background-color: white; text-decoration: none; font-size: smaller; padding-left: 1em; padding-bottom: 0.2em; cursor: pointer; }

.example_fake { position: absolute; left: 0px; top: 0px; border-radius: 0.5em 0px; background-color: rgb(0, 0, 136); padding: 0.2em; color: white; }

.example_fake_horizontal { border-radius: 0.5em; }

#examples_horizontal_list { display: grid; gap: 10px; word-break: break-word; }

#examples_horizontal_list .example:target { outline: rgb(0, 0, 136) solid 1px; }

#examples_horizontal_list > div { border-top: 1px solid rgb(204, 204, 204); padding: 0.1em 0.5em; display: flex; position: relative; }

#examples_horizontal_list > div > div:first-child { width: 16em; min-width: 16em; }

.example_full_description { flex: 1 1 0%; margin-left: 1.5em; }

@media only screen and (max-width: 700px) {
  #examples_horizontal_list > div { flex-wrap: wrap; }
  #examples_horizontal_list > div > div:first-child { flex: 1 1 100%; }
  .example_full_description { margin-left: 0px; margin-top: 0.5em; }
}

.example_list_image { width: 16em; max-height: 7em; overflow: hidden; white-space: nowrap; }

.example_list_image img { height: 7em; width: auto; max-width: none; vertical-align: bottom; }

@media screen and (max-width: 790px) {
  #examples_list { grid-template-columns: repeat(2, 17em); }
}

@media screen and (max-width: 520px) {
  #examples_list { grid-template-columns: 17em; }
}

.guideline_button { padding: 0px; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; line-height: 16px; }

.guideline_button img { vertical-align: bottom; width: 16px; height: 16px; }

#sales_list { border-collapse: collapse; border-bottom: 1px solid rgb(204, 204, 204); }

#sales_list th { white-space: nowrap; padding: 0px 1em 0.2em 0px; text-align: left; }

#sales_list th a { color: rgb(0, 0, 0); }

#sales_list td { padding-right: 1em; border-top: 1px solid rgb(204, 204, 204); }

#sales_list td:last-child { padding-right: 0px; }

#sales_list .sale_pictures div { max-width: 10.5em; height: 5em; overflow: hidden; white-space: nowrap; margin-top: 0.1em; }

#sales_list .sale_pictures div img { height: 5em; width: auto; max-width: none; vertical-align: bottom; }

#sales_list .sale_price .unbreakable, #sales_list .sale_date { white-space: nowrap; }

#sales_list .sales_details { font-size: 0.9em; color: rgb(89, 89, 89); }

#sales_list .sale_grade { text-align: center; }

#sales_list .sale_price, #sales_list .sale_original_price { text-align: right; font-variant-numeric: tabular-nums; }

#sales_list .sale_price { padding-right: 0.5em; }

#sales_list .sale_copyright, #sales_list .sale_comment_row td { font-size: 0.9em; padding-top: 0px; border-top-width: medium; border-top-style: none; border-top-color: currentcolor; }

#sales_list .sale_copyright a { color: black; }

#sales_list tbody:has(+ .sales_list_group) tr:last-child td, #sales_list thead:has(+ .sales_list_group) th { padding-bottom: 1em; }

#sales_list .sales_list_group tr:first-child td { padding-top: 0.8em; }

.sales_list_group { border: 2px solid rgb(204, 204, 204); position: relative; }

#sales_list .sales_list_group td:first-child { padding-left: 0.5em; padding-right: 0.5em; }

#sales_list .sales_list_group td:last-child { padding-right: 0.5em; }

.sales_list_group_title { position: absolute; top: -0.8em; left: 1em; background: white; padding: 0px 0.5em; font-style: italic; color: rgb(102, 102, 102); }

@media (max-width: 750px) {
  #sales_list { display: block; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }
  #sales_list thead { display: none; }
  #sales_list tbody { display: block; }
  #sales_list tr { display: block; clear: left; border-top: 1px solid rgb(204, 204, 204); padding: 0.5em 0px 0.5em 11em; }
  #sales_list tr:last-child { border-bottom: 1px solid rgb(204, 204, 204); }
  #sales_list td { display: block; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; text-align: left !important; }
  #sales_list .sale_pictures { float: left; margin-left: -11em; }
  #sales_list .sale_grade br { display: none; }
  #sales_list .sale_auction br { display: inline-block; vertical-align: top; zoom: 1; content: ""; width: 0.5em; height: 1.2em; }
  #sales_list .sale_auction br::before { content: ", "; }
  #sales_list .sale_price br { display: none; }
  #sales_list .sale_original_price { display: inline-block; margin-left: 0px; }
  #sales_list .sale_copyright_row, .sale_comment_row { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px 0px 0.5em; margin-top: -0.5em; }
  #sales_list .sale_copyright { margin-left: 0px; }
}

@media (max-width: 600px) {
  #sales_list .sale_pictures div { width: 5em; max-width: 5em; }
  #sales_list tr { padding-left: 6em; }
  #sales_list .sale_pictures { margin-left: -6em; }
}

.price_table { border-collapse: collapse; border-bottom: 2px solid aliceblue; }

.price_table tr:nth-child(2n) { background-color: aliceblue; }

.price_table tr:nth-child(2n+1) { background-color: rgb(255, 255, 255); }

.price_table th { text-align: left; position: sticky; top: 0px; background-color: rgb(255, 255, 255); }

.price_table td, .price_table th { padding: 0.1em 0.5em; }

.form .lettering_textarea { width: 80%; padding: 0.5em; }

.form .script_select, .form .engraver_select { width: 80%; }

.special_keyboard_box { border: 1px dotted black; background: rgb(240, 240, 240); margin: 0.5em 0px 1em; padding: 0.5em; width: 80%; box-sizing: border-box; }

.reference_input { padding-bottom: 0.3em; }

.reference_input select { width: 9em; }

.reference_input .select2 { vertical-align: top; }

.reference_input input[type="text"] { width: 5rem; }

.catalogue_details { display: block; max-height: 3.2em; padding-bottom: 5px; overflow: hidden; position: relative; color: rgb(102, 102, 102); }

.catalogue_details::before { content: " "; display: block; background: url("ellipsis-vertical.png"); width: 100%; height: 8px; position: absolute; bottom: 0px; }

.form .two_dimensions input { width: 6.5rem; }

#dimension_separator { display: inline-block; width: 2rem; text-align: center; }

#printer_list select { width: 100%; }

#date_table th { vertical-align: middle; text-align: center; }

#date_table td { vertical-align: top; }

#date_table input[type="text"] { vertical-align: top; height: 32px; }

#date_table .date_check { padding-top: 10px; }

#date_table .date_year input { width: 3em; }

#date_table .date_month input, #date_table .date_day input { width: 2em; }

#date_table .date_sign select { width: 15em; }

#date_table .date_mark select { width: 7em; height: 2em; }

.select2-container .mark_container { display: inline-block; padding: 0.1em; }

.select2-container .mark { max-width: 1.2em; max-height: 1.2em; }

.select2-results .mark_container { display: inline-block; min-width: 1.4em; }

#date_table .date_mint input { width: 3em; }

#date_table .date_mintage input { width: 6em; text-align: right; }

#date_table .reference { padding-right: 0.2em; padding-left: 0.4em; width: 12em; display: flex; justify-content: space-between; align-items: center; }

#date_table .date_trans { font-size: 90%; color: rgb(102, 102, 102); text-align: left; }

.simplified_button { background: none; border: 0px; margin: 0px; padding: 0px; color: black; cursor: pointer; }

.first_version_reference { margin-top: 0.1em; width: 4em !important; height: 1.8em !important; }

.second_version_reference { margin-bottom: 0.5em; margin-top: 0.4em; width: 4em !important; height: 1.8em !important; }

@media (max-width: 550px) {
  .sticky_submit { position: sticky; bottom: 0px; background: rgb(255, 255, 255); margin: 0px -1em; padding: 1em 0px; border-top: 1px solid rgb(204, 204, 204); }
}

@media (min-width: 600px) {
  .add_sale_checkbox { text-align: center; margin: 0px 0px 0.5em; }
}

#request_list_filter { margin: 1em 0px 0px; }

#request_list_filter > div { margin: 0px 0px 0.5em; }

#request_list { margin-top: 1em; }

#request_list td { vertical-align: top; word-break: break-word; }

#request_list .request_date { white-space: nowrap; }

#request_list div { padding: 0.1em; border-radius: 0.4em; text-align: center; white-space: nowrap; }

#request_list div.attente, .request_history_container div.attente { background: rgb(245, 239, 171); }

#request_list div.valide, .request_history_container div.valide { background: rgb(171, 245, 171); }

#request_list div.refuse, .request_history_container div.refuse { background: rgb(245, 193, 172); }

#request_list div.revision, .request_history_container div.revision { background: rgb(223, 238, 251); }

#request_list div.questioned, .request_history_container div.questioned { background: rgb(113, 159, 199); }

#request_list div.supprime, .request_history_container div.supprime { background: rgb(245, 193, 172); }

#request_list div.partiel, .request_history_container div.partiel { background: rgb(171, 245, 220); }

#request_list div.annule, .request_history_container div.annule { background: rgb(221, 221, 221); }

#request_list div.appeal, .request_history_container div.appeal { background: rgb(203, 187, 247); }

@media (max-width: 550px) {
  #request_list tr, #request_list tbody, #request_list tr, #request_list td { display: block; padding: 0px !important; }
  #request_list { margin-top: 0px; }
  #request_list .request_date { margin-top: 1em; }
}

.alphabets { border: 1px solid rgb(204, 204, 204); margin: 0.5em 0px; padding: 0.3em; border-radius: 0.3em; }

.alphabets a { display: inline-block; border: 1px solid rgb(204, 204, 204); margin: 0px 1px 1px 0px; width: 1.2em; height: 1.2em; font-size: 130%; padding: 0.1em; text-align: center; background: rgb(240, 240, 240); color: rgb(0, 0, 0); text-decoration: none; border-radius: 2px; vertical-align: bottom; }

.alphabets .character_separator { display: inline-block; width: 0.5em; height: 1.2em; }

.tamoul a { width: auto; }

.all_coins summary { margin: 0.5em 0px 0px; }

.all_coins a { margin-left: 2em; }

.contribution_opportunities { list-style-type: none; }

.contribution_opportunities li { margin: 0px 0px 0.2em; }

#ignore_notification { background: rgb(0, 0, 136); color: rgb(255, 255, 255); margin: 1em auto 0px; padding: 0.5em 1em; border-radius: 0.5em; max-width: max-content; position: fixed; bottom: 1em; box-shadow: rgba(0, 0, 0, 0.5) 1px 2px 0.5em 0px; left: 50%; transform: translateX(-50%); z-index: 1; }

#ignore_notification button { margin-left: 0.5em; }

.ruler_list { margin-bottom: 0.2em; }

@media (max-width: 520px) {
  .ruler_list { margin-bottom: 0.5em; }
}

.ruler_list summary { display: inline; }

.ruler_list div { padding: 0px 0px 0.2em 3em; }

.ruler_list h2 { display: inline; font-size: 1rem; margin: 0px; font-weight: normal; color: rgb(0, 0, 0); }

.ruler_list ul { list-style-type: disc; }

.ruler_examples { margin: 1em 0px 2em; clear: left; }

.ruler_examples h2 { font-size: 1rem; margin: 0px; }

.ruler_examples ul { display: flex; flex-wrap: wrap; }

.ruler_examples li { width: 8.5em; max-height: 12.5em; overflow: hidden; text-overflow: ellipsis; margin: 0.5em 1em 0.5em 0px; text-align: center; }

.ruler_examples li a { display: block; width: 8em; }

@media (max-width: 520px) {
  .ruler_examples li:nth-child(5) { display: none; }
}

.ruler_portrait { float: left; margin: 0px 1em 1em 0px; max-width: 50%; }

#tags { list-style-type: none; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1em; }

#tags li { display: grid; grid-template-columns: 5em auto; grid-template-rows: min-content 1fr; gap: 0.2em 0.5em; box-shadow: rgba(0, 0, 0, 0.5) 1px 2px 0.5em 0px; border-radius: 0.5em; margin: 0px; padding: 0.5em; }

#tags li .head { grid-row: 1 / span 2; width: 5em; height: 5em; }

#tags > span { padding-top: 0.5em; }

@media (max-width: 1100px) {
  #tags { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 600px) {
  #tags { display: block; }
  #tags li { box-shadow: none; padding: 0.5em 0px; border-radius: 0px; border-bottom: 1px solid rgb(204, 204, 204); }
}

#issuer_changes { display: grid; grid-template-columns: min-content 1fr; margin: 2em 0px 0px; }

#issuer_changes .change_date { grid-column-start: 1; position: relative; padding-right: 1em; font-weight: bold; white-space: nowrap; }

#issuer_changes .change_message { grid-column-start: 2; padding: 0px 0px 1em 1em; border-left: 1px solid black; }

#issuer_changes .change_date::after { content: url("data:image/svg+xml; utf8, <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"7\" height=\"7\"><circle cx=\"3.5\" cy=\"3.5\" r=\"3.5\" fill=\"black\"/></svg>"); position: absolute; right: -4px; top: 0px; }

#issuer_changes .change_date.major::after { content: url("data:image/svg+xml; utf8, <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\"><circle cx=\"6.5\" cy=\"6.5\" r=\"6.5\" fill=\"black\"/></svg>"); right: -7px; }

@media (max-width: 600px) {
  #issuer_changes { display: block; border-left: 1px solid black; }
  #issuer_changes .change_date { padding: 0px 0px 0px 1em; margin: 1em 0px 0px; font-weight: normal; font-style: italic; }
  #issuer_changes .change_message { padding: 0px 0px 0px 1em; margin: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }
  #issuer_changes .change_date::before { content: url("data:image/svg+xml; utf8, <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"7\" height=\"7\"><circle cx=\"3.5\" cy=\"3.5\" r=\"3.5\" fill=\"black\"/></svg>"); position: absolute; left: -4px; top: 0px; }
  #issuer_changes .change_date.major::before { content: url("data:image/svg+xml; utf8, <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\"><circle cx=\"6.5\" cy=\"6.5\" r=\"6.5\" fill=\"black\"/></svg>"); right: -7px; }
  #issuer_changes .change_date::after, #issuer_changes .change_date.major::after { content: none; }
}

.issuer_change_data { font-size: 0.9em; }

#issuer_change_range_picker { margin: 0.5em 0px 2em; background: rgb(223, 238, 251); border-radius: 0.5em; padding: 1em; }

.request_history_container { display: grid; grid-template-columns: max-content max-content max-content auto; max-width: max-content; }

.request_history_header { padding: 0px 1em 0.3em 0px; border-bottom: 1px solid rgb(204, 204, 204); font-weight: bold; }

.request_history_header.request_status { text-align: center; }

.request_history_cell { border-bottom: 1px solid rgb(204, 204, 204); padding: 0.3em 1em 0.3em 0px; }

.request_history_cell div { padding: 0.1em 0.2em; border-radius: 0.4em; text-align: center; white-space: nowrap; }

.request_stretch { padding-right: 0px; overflow-wrap: break-word; overflow: hidden; }

@media screen and (max-width: 700px) {
  .request_history_container { grid-template-columns: repeat(3, 1fr); }
  .request_history_header:nth-child(4) { display: none; }
  .request_history_cell.request_status, .request_history_header.request_status { padding-right: 0px; }
  .request_history_cell div { white-space: initial; }
  .request_history_cell:not(.request_stretch) { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; padding-bottom: 0px; }
  .request_stretch { grid-column: span 3; }
}

.admin_table { border: 1px solid rgb(240, 248, 255); border-radius: 0.5em; overflow: hidden; width: max-content; }

.admin_table table { border-collapse: collapse; }

.admin_table td, .admin_table th { padding: 0.3em 0.5em; }

.admin_table tr:nth-child(2n+1) { background: rgb(240, 248, 255); }

.admin_table.admin_unregistrations tr:nth-child(4n), .admin_table.admin_unregistrations tr:nth-child(4n+1) { background: rgb(240, 248, 255); }

.admin_table.admin_unregistrations tr:nth-child(4n+2), .admin_table.admin_unregistrations tr:nth-child(4n+3) { background: rgb(255, 255, 255); }

.admin_table th { text-align: left; }

.admin_table th em { font-weight: normal; font-style: normal; }

.admin_table .c { text-align: center; }

.admin_table .fixed { max-width: 20%; overflow-wrap: break-word; }

.warning_number { font-style: normal; color: rgb(219, 102, 0); }

.admin_report_table { max-width: 100%; }

.input_source_modal { display: none; position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); justify-content: center; align-items: center; z-index: 1000; }

.input_source_modal_content { background: rgb(255, 255, 255); padding: 1.5em; border-radius: 0.5em; text-align: center; margin: 1.5em; position: relative; }

.input_source_modal_content p { margin-bottom: 1em; }

.close-modal-button { position: absolute; top: 0px; right: 0px; background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; font-size: 1.5em; color: rgb(136, 136, 136); padding: 0px 0.5rem; }

.input_source_modal_buttons { display: flex; flex-wrap: wrap; gap: 0.5em 1em; justify-content: center; }

td.new_value, td.current_value { position: relative; }

td.new_value::before, td.current_value::before { content: ""; position: absolute; top: 0px; left: 0px; width: 0px; height: 0px; border-top: 1em solid rgb(0, 136, 0); border-right: 1em solid transparent; }

td.current_value::before { border-top-color: rgb(136, 68, 0); }

.set_content { list-style-type: none; }

.set_content > li { display: grid; grid-template-columns: 3.75em 3.75em auto; margin: 0px 0px 0.5em; gap: 0.5em; }

.set_content .set_content_picture { max-width: 3.75em; max-height: 3.75em; }

.coin-gallery { display: flex; gap: 20px; align-items: flex-start; max-width: 800px; margin: 0px auto; }

.coin-gallery-main { position: relative; flex: 1 1 0%; background-color: rgb(249, 249, 249); border-radius: 8px; display: flex; justify-content: center; align-items: center; overflow: hidden; }

.coin-gallery-main img { max-width: 100%; max-height: 100%; height: auto; width: auto; object-fit: contain; border-radius: 4px; }

.coin-gallery-copyright { position: absolute; bottom: 8px; right: 10px; font-size: 12px; padding: 4px 8px; border-radius: 4px; max-width: 95%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.coin-gallery-thumbnails { display: flex; flex-direction: column; width: 80px; gap: 10px; }

.coin-gallery-thumbnails img { width: 70px; height: 70px; object-fit: cover; cursor: pointer; opacity: 0.6; border: 2px solid transparent; border-radius: 4px; transition: border 0.3s, opacity 0.3s; }

.coin-gallery-thumbnails img.coin-gallery-thumb-active { opacity: 1; border-color: rgb(0, 123, 255); }

.set_caracteristiques { max-width: calc(35% - 0.5em); }

#fiche_photo.set_photo { width: 65%; }

@media (max-width: 700px) {
  .set_caracteristiques { max-width: unset; }
  #fiche_photo.set_photo { width: unset; }
}

#current_listings { border-top: 1px solid rgb(204, 204, 204); margin-bottom: 1em; }

#current_listings > div { display: grid; grid-template-columns: 8em auto; align-items: flex-start; border-bottom: 1px solid rgb(204, 204, 204); padding: 0.5em 0px; gap: 1em; }

#current_listings .listing_picture_link img { width: 8em; height: 6em; object-fit: cover; display: block; }

#current_listings .item_vendor { margin-bottom: 0.2em; }

#current_listings .item_title { margin-bottom: 0.5em; }

#current_listings .item_price a[title^="E"]::after, #current_listings .item_price a[title^="C"]::after { content: " "; display: inline-block; height: 19px; width: 19px; margin: 0px 0px -0.2em 0.2em; background: url("icons-sprite36.png") -137px -74px no-repeat; print-color-adjust: exact; }

#current_listings .promo_details { margin: 0.5em 0px 0px; color: rgb(68, 68, 68); font-size: 0.9em; }

#current_sales_disclaimer { color: rgb(119, 119, 119); font-size: 0.9em; font-style: italic; }

#technique_list { list-style-type: none; display: grid; grid-template-columns: 1fr 1fr 1fr 1fr 1fr; gap: 1em; }

@media (max-width: 1100px) {
  #technique_list { grid-template-columns: 1fr 1fr 1fr 1fr; }
}

@media (max-width: 700px) {
  #technique_list { grid-template-columns: 1fr 1fr 1fr; }
}

@media (max-width: 500px) {
  #technique_list { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 300px) {
  #technique_list { grid-template-columns: 1fr; }
}

#technique_list li { box-shadow: rgba(0, 0, 0, 0.5) 1px 2px 0.5em 0px; margin: 0px; text-align: center; padding: 0.5em; border-radius: 0.5em; overflow: hidden; }

#technique_list img { width: calc(100% - 1em); height: auto; max-height: 100%; margin-bottom: 0.5em; aspect-ratio: 1 / 1; object-fit: contain; }

.picture-source-option { padding-left: 0.5em; text-indent: -0.5em; }

.picture-source-name { overflow-wrap: anywhere; }

.picture-source-url { color: rgb(102, 102, 102); word-break: break-all; }
