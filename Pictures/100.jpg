@media (max-width: 600px) {
  h1 { font-size: 2em; }
  #main_title p { font-size: 1.3em; }
}

h2 { color: rgb(0, 0, 136); margin: 2rem 0px 1rem; padding: 0px; font-size: 1.5em; }

h3 { font-size: 1.2em; color: rgb(0, 0, 136); margin: 1.5rem 0px 0.3rem; line-height: 1.4em; }

h4 { font-size: 1.1em; margin: 1rem 0px 0.3rem; }

