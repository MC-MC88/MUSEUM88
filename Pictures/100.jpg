html, body { margin: 0px; padding: 0px; }

#global_container { display: flex; flex-direction: column; min-height: 100vh; }

@media (min-width: 1300px) {
  #global_container > * { padding-left: calc(-100% + 100vw); }
}

#global_container .middle_element { max-width: 75em; box-sizing: border-box; padding: 0px 1em; margin: 0px auto; }

#global_container.premium .middle_element { max-width: 65em; }

#global_header { background: rgb(223, 238, 251); box-shadow: rgba(0, 0, 0, 0.5) 0px 0px 0.5em 0px; }

@media print {
  #global_header { display: none; }
}

#main_header { margin: 1em 0px 0px; display: flex; }

#global_logo svg { width: 9em; height: auto; filter: drop-shadow(rgb(255, 255, 255) 0px 0px 1rem); margin: -0.2em 0px 0px -0.2em; }

@media (max-width: 420px) {
  #global_logo svg { width: 7em; margin: 0.1rem 0.5rem 0.2rem 0px; }
}

#main_header_spacer { flex-grow: 1; }

#top_search_bar { white-space: nowrap; margin: 0.3em 1em 0px 0px; }

.top_search_bar > * { height: 1.7em; box-sizing: border-box; vertical-align: bottom; }

.top_search_bar input[type="text"] { width: 15em; border-width: 1px medium 1px 1px; border-style: solid none solid solid; border-color: rgb(0, 0, 136) currentcolor rgb(0, 0, 136) rgb(0, 0, 136); border-image: none; border-radius: 0.5rem 0px 0px 0.5rem; background: rgba(239, 247, 250, 0.9); padding: 0.2em; box-sizing: border-box; }

.top_search_bar select { margin: 0px 0.3em 0px 0px; border-width: 1px; border-style: solid; border-color: rgb(0, 0, 136) rgb(0, 0, 136) rgb(0, 0, 136) rgb(136, 136, 170); border-image: none; border-radius: 0px 0.5rem 0.5rem 0px; width: auto; box-sizing: border-box; appearance: none; background-color: rgba(239, 247, 250, 0.9); background-image: url("data:image/svg+xml;base64,"); background-repeat: no-repeat; background-position: 100% 6px; padding: 0.1em 1.5rem 0.2em 0.2em; }

.top_search_bar svg { height: 1em; width: 1em; margin: 0.1em 0px 0px; }

.top_search_bar path { fill: rgb(226, 239, 250); }

#search_menu, #search_menu_button { display: none; }

@media (max-width: 960px) {
  #top_search_bar input[type="text"] { width: 10em; }
}

@media (max-width: 875px) {
  #top_search_bar input[type="text"] { width: 8em; }
  #top_search_bar select { max-width: 6em; }
}

@media (max-width: 795px) {
  #top_search_bar { display: none; }
  #search_menu { display: block; margin: 0px -0.5em; max-height: 0px; box-sizing: border-box; transition: 0.25s ease-in-out; overflow: hidden; }
  #search_menu div { display: flex; max-width: 100%; }
  #search_menu .top_search_bar > * { height: 2em; vertical-align: bottom; }
  #search_menu input[type="text"] { flex-grow: 1; flex-shrink: 1; width: 10em; min-width: 4em; }
  #search_menu select { min-width: 6em; flex-shrink: 2; padding-top: 0.4em; background-position-y: 8px; }
  #search_menu button { padding-top: 0.3em; }
  #search_menu[aria-hidden="false"] { max-height: 2.5em; margin-top: 0.5em; margin-bottom: 0.5em; }
  #search_menu_button { display: block; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin: 0.3em 1em 0px 0px; }
  #search_menu_button svg { width: 1.2em; height: 1.2em; fill: rgb(0, 0, 136); }
}

#language_menu_button { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: none; color: rgb(0, 0, 136); font-weight: normal; border-radius: 0.5em 0.5em 0px 0px; margin: 0.3em 1em 0px 0px; white-space: nowrap; }

.rotatory_menu_arrow { fill: rgb(0, 0, 136); width: 0.6em; height: 0.6em; transform: rotate(180deg); transition: transform 0.2s ease-in-out; }

[aria-pressed="true"] .rotatory_menu_arrow { transform: rotate(0deg); }

#language_menu { max-height: 30em; overflow: hidden; transition: 0.25s ease-in-out; padding: 0.3em 0.8em 0px; position: absolute; border-radius: 0px 0.5em 0.5em; }

#language_menu li { list-style-type: none; margin: 0px; padding: 0.5em 0px; }

#language_menu a:hover { text-decoration: none; border-bottom: 1px solid; }

#language_menu_button[aria-pressed="true"] { background: rgba(239, 247, 250, 0.9); }

#language_menu[aria-hidden="false"] { background: rgba(239, 247, 250, 0.9); z-index: 10; }

#language_menu[aria-hidden="true"] { max-height: 0px; }

@media (max-width: 795px) {
  #language_menu_button { margin-right: 0.5em; }
}

@media (max-width: 600px) {
  #language_menu_button { font-size: 0.9rem; margin: 0.4em 0.5em 0px 0px; }
  #language_menu { font-size: 0.9rem; }
}

#top_sign_buttons a { display: inline-block; margin-top: 0.3em; }

#top_sign_buttons a:first-child { background: rgba(239, 247, 250, 0.9); margin-right: 0.8em; }

@media (max-width: 550px) {
  #top_sign_buttons a:last-child { display: none; }
  #top_sign_buttons a:first-child { margin-right: -0.5em; }
}

@media (max-width: 350px) {
  #top_sign_buttons a:first-child { padding: 0.2em 2px; }
}

@media (max-width: 340px) {
  #top_sign_buttons a:first-child { margin-right: -0.8em; }
}

#account_badge { display: flex; height: 1.8rem; align-items: center; border: 1px solid rgb(0, 0, 136); border-radius: 1.8rem; padding: 0.2rem; background: rgba(239, 247, 250, 0.9); white-space: nowrap; }

#account_badge label { padding-right: 0.5em; }

.header_avatar { max-height: 1.8rem; vertical-align: middle; border-radius: 1em; }

#account_menu_button { width: 25px; height: 20px; position: relative; flex-shrink: 0; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 0px; background: none; margin-right: 0.5em; }

#account_menu_button span { display: block; position: absolute; height: 4px; width: 100%; background: rgb(0, 0, 136); border-radius: 4px; opacity: 1; left: 0px; transition: 0.25s ease-in-out; }

#account_menu_button span:nth-child(1) { top: 0px; }

#account_menu_button span:nth-child(2), #account_menu_button span:nth-child(3) { top: 8px; }

#account_menu_button span:nth-child(4) { top: 16px; }

#account_menu_button[aria-pressed="true"] span:nth-child(1) { top: 8px; width: 0px; left: 50%; }

#account_menu_button[aria-pressed="true"] span:nth-child(2) { transform: rotate(45deg); }

#account_menu_button[aria-pressed="true"] span:nth-child(3) { transform: rotate(-45deg); }

#account_menu_button[aria-pressed="true"] span:nth-child(4) { top: 18px; width: 0px; left: 50%; }

.notifications #account_menu_button::after, #pinned_account_menu .notifications::after { content: " "; background: rgb(245, 114, 0); display: block; width: 10px; height: 10px; border-radius: 8px; position: absolute; margin: -4px -4px 0px 0px; right: 0px; top: 0px; }

#account_menu { max-height: 20em; position: relative; overflow: hidden; transition: 0.25s ease-in-out; border-top: 1px solid rgb(170, 181, 238); border-bottom: 1px solid rgb(170, 181, 238); }

#account_menu[aria-hidden="true"] { border-top: 0px solid rgb(170, 181, 238); border-bottom: 0px solid rgb(170, 181, 238); max-height: 0px; }

#account_menu a { border-bottom: 1px solid transparent; }

#account_menu a:hover { border-bottom: 1px solid rgb(0, 0, 136); }

#global_header em { font-style: normal; font-size: 1rem; color: rgb(219, 102, 0); }

#global_header nav ul { flex-grow: 1; margin: 0px; text-align: center; padding: 0.5em 0px 0.2em; font-size: 1.2rem; }

#global_header nav li { display: inline-block; list-style-type: none; margin: 0px 1.5em 0.3em 0px; text-align: center; white-space: nowrap; position: relative; }

[lang="es"] #account_menu li { margin-right: 1em; }

#global_header nav li a { color: rgb(0, 0, 136); text-shadow: rgb(255, 255, 255) 0px 0px 8px; text-decoration: none; position: relative; display: inline-block; }

#global_header nav li svg { vertical-align: middle; margin: 0px 0.1em 0px 0px; }

#global_header nav li.current_nav span, #account_menu .current_nav a { border-bottom: 1px solid rgb(0, 0, 136); }

#global_header nav li a span { border-bottom: 1px solid transparent; }

#global_header nav li a:hover span { border-bottom: 1px solid rgb(0, 0, 136); }

.icons_menu ul { font-size: 1.2rem; }

.icons_menu path { fill: rgb(0, 0, 136); }

#global_header #global_menu_last { margin: 0px; }

#global_header #global_menu_last ol { padding: 0px; }

#global_header #global_menu_last_button_container { display: none; }

@media (max-width: 800px) {
  #global_header nav ul { font-size: 1.1rem; }
  .icons_menu span { display: block; }
  #account_menu li { margin: 0px 0.5em 0.5em; }
  #global_menu em { display: none; }
  #global_menu .notification::after { content: " "; background: rgb(245, 114, 0); display: block; width: 10px; height: 10px; border-radius: 8px; position: absolute; margin: 0px 0px 0px 5px; left: 50%; top: 0px; }
}

@media (max-width: 730px) {
  #global_header .icons_menu ul { margin: 0px -1rem; }
  #global_header .icons_menu li { margin-left: 0.6em; margin-right: 0.6em; }
}

@media (max-width: 650px) {
  #global_header nav li { font-size: 1rem; font-weight: normal; }
  #global_header .icons_menu li { margin-left: 0.4em; margin-right: 0.4em; }
  #global_header #account_menu li { display: block; flex-direction: column; margin: 0.3em 0px 0.8em; }
}

@media (max-width: 795px) {
  #account_badge { margin-right: -0.5em; }
}

@media (max-width: 550px) {
  #account_badge .img_label { display: none; }
  #account_badge { padding-left: 0.3em; padding-right: 0.3em; }
  #account_menu_button { transform: scale(0.9); }
  #account_badge > * { margin-right: 0.2em; }
  #language_menu_button { padding-right: 0.1em; padding-left: 0.5em; margin-right: 1em; }
  #language_menu { padding-left: 0.5em; padding-right: 0.5em; }
  #search_menu_button { padding-right: 0.1em; padding-left: 0.1em; }
  #global_header #global_menu_last_button_container { display: inline-block; border-bottom-color: transparent; }
  #global_header #global_menu_last_button_container span { border-bottom-color: transparent; }
  #global_header #global_menu_last { display: block; max-height: 0px; overflow: hidden; transition: 0.5s; }
  #global_header #global_menu_last[aria-hidden="false"] { max-height: 5em; }
}

@media (max-width: 440px) {
  #account_badge .img_label { display: block; }
  #account_badge .text_label { display: none; }
  #global_header .icons_menu li { margin-left: 0.2em; margin-right: 0.2em; }
}

@media (max-width: 389px) {
  #global_header .icons_menu li { font-size: 0.9rem; }
}

@media (max-width: 319px) {
  #language_menu_button { display: none; }
}

#account_menu button, #pinned_account_menu button { display: block; position: absolute; bottom: 0px; right: 0px; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0.2em; }

#account_menu button img, #pinned_account_menu button img { height: 1em; width: 1em; }

#account_menu { background: rgba(255, 255, 250, 0); }

#pinned_account_menu { display: none; }

@media (max-width: 600px) {
  #global_header.pinned_account #account_menu .redundant { display: none; }
  .pinned_account #account_menu button { display: none; }
  .pinned_account #pinned_account_menu { position: relative; margin: 0px -1em 0.2em; display: block; background: rgba(239, 247, 250, 0.9); border-top: 1px solid rgb(187, 219, 247); border-bottom: 1px solid rgb(187, 219, 247); padding-right: 2.5em; padding-left: 1em; }
  .pinned_account #account_menu[aria-hidden="false"] { margin-bottom: 0.5em; }
  .pinned_account .notifications #account_menu_button::after { display: none; }
  #pinned_account_menu .notifications::after { left: 50%; margin: 0px 0px 0px 4px; }
}

@media (max-width: 380px) {
  .icons_menu span { overflow: hidden; }
  #my_swaps_pinned_link { max-width: 4.3em; text-overflow: ellipsis; }
}

@media (min-width: 601px) {
  .pinned_account #account_menu { max-height: 20em; background: rgba(239, 247, 250, 0.9); border-radius: 0.5em; border: 1px solid rgb(187, 219, 247); padding-right: 1em; padding-left: 1em; }
  .pinned_account #main_header > div:nth-child(3) { order: 4; }
  .pinned_account #main_header > div:nth-child(4) { order: 3; }
  .pinned_account #top_search_bar { margin-right: 0px; }
  .pinned_account #account_badge { display: none; }
  .pinned_account #top_search_bar { display: block; }
  .pinned_account #search_menu_button, .pinned_account #search_menu { display: none; }
}

#bottompub_container .middle_element { margin: 0px auto 34px; overflow: hidden; position: relative; }

#global_footer { background: rgb(223, 238, 251); padding: 1.5em 0px 1em; text-align: center; }

@media print {
  #top_link, .footer_links { display: none !important; }
  #global_footer { border-top: 1px solid rgb(204, 204, 204); }
}

#main_container { flex-grow: 1; margin: 0px 0px 50px; }

#main_container main { display: inline-block; vertical-align: top; width: calc(100% - 210px); position: relative; }

#rightpub { display: inline-block; position: sticky; top: 1em; vertical-align: top; width: 160px; margin: 50px 0px 0px 50px; text-align: right; }

@media print {
  #main_container main { display: block; width: auto; }
  #rightpub { display: none; }
}

.premium #main_container main { display: block; width: auto; }

.premium #rightpub { display: none; }

#main_breadcrumb { margin: 1em 0px; color: rgb(85, 85, 85); }

#top_link { display: none; position: fixed; right: 1em; bottom: 1em; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; }

#top_link path { fill: rgb(0, 0, 136); }

@media (max-width: 950px) {
  #rightpub { display: none; }
  #main_container .middle_element { padding-right: 1em; }
  #main_container main { flex-grow: 1; position: relative; width: 100%; }
}

#bottompub_container .catawiki_list { max-width: 60em; }

#bottompub_container .catawiki_list p { text-align: left; }

#bottompub_container .catawiki_list .buy_coin_links { grid-template-columns: calc(25% - 10px) calc(25% - 10px) calc(25% - 10px) calc(25% - 10px) calc(25% - 10px) calc(25% - 10px) calc(25% - 10px) calc(25% - 10px) calc(25% - 10px); column-gap: 10px; }

@media (max-width: 820px) {
  #bottompub_container .catawiki_list .buy_coin_links { grid-template-columns: calc(25% - 10px) calc(25% - 10px) calc(25% - 10px) calc(25% - 10px) calc(25% - 10px) calc(25% - 10px) calc(25% - 10px) calc(25% - 10px) calc(25% - 10px); column-gap: 10px; }
}

@media (max-width: 750px) {
  #bottompub_container .catawiki_list .buy_coin_links { grid-template-columns: calc(33.333% - 10px) calc(33.333% - 10px) calc(33.333% - 10px) calc(33.333% - 10px) calc(33.333% - 10px) calc(33.333% - 10px) calc(33.333% - 10px) calc(33.333% - 10px) calc(33.333% - 10px); }
}

@media (max-width: 520px) {
  #bottompub_container .catawiki_list .buy_coin_links { grid-template-columns: calc(50% - 10px) calc(50% - 10px) calc(50% - 10px) calc(50% - 10px) calc(50% - 10px) calc(50% - 10px) calc(50% - 10px) calc(50% - 10px) calc(50% - 10px); }
}

@media print {
  #bottompub_container { display: none; }
}

.buy_coin_links > p { text-align: center; margin: -1em 0px 1.5em; color: rgb(119, 119, 119); font-variant: all-small-caps; font-weight: bold; }

.buy_coin_links > div p { font-size: 80%; color: rgb(0, 0, 136); text-align: right; position: absolute; top: -1.5em; right: 0.3em; width: 100%; }

.buy_coin_links > div { position: relative; border: 1px solid rgb(0, 0, 136); border-radius: 0.5em; padding: 0.3em; margin: 1em 0px 2em; text-align: center; }

.buy_coin_links .item_title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; padding: 0px; margin: 0px; max-width: 100%; max-height: 2.5em; overflow: hidden; text-overflow: ellipsis; text-align: left; font-size: 80%; }

.buy_coin_links .item_price { display: block; margin-top: 0.5em; border: 1px solid rgb(255, 255, 255); box-sizing: border-box; border-radius: 0.4em; padding: 0px 0.3em 0.1em; background: rgb(0, 0, 136); color: rgb(255, 255, 255); font-weight: bold; font-size: 90%; }

.buy_coin_links .item_price:hover { border-color: rgb(0, 0, 136); text-decoration: none; }

.buy_coin_links .item_price[title^="E"]::after, .buy_coin_links .item_price[title^="C"]::after { content: " "; display: inline-block; height: 19px; width: 19px; margin: 0px 0px -0.2em 0.2em; background: url("icons-sprite36.png") -137px -74px no-repeat; print-color-adjust: exact; }

.buy_coin_links .buy_perc { position: absolute; top: 2px; right: 2px; padding: 0.2em; border-radius: 0.5em; background: rgb(223, 238, 251); color: rgb(0, 0, 136); }

.catawiki_list { overflow: hidden; }

.catawiki_list p { font-size: 80%; color: rgb(0, 0, 136); text-align: center; }

.catawiki_list p img { height: 1em; margin-bottom: 0.3em; }

.catawiki_list .buy_coin_links { display: grid; grid-template-columns: 100% 100% 100%; opacity: 0; animation: 40s ease-in-out 0.5s infinite normal none running anim_widget; }

.catawiki_list .buy_coin_links:hover { animation-play-state: paused; }

.catawiki_list .buy_coin_links > div { margin: 0px 0px 0.5em; padding-bottom: 2em; }

.catawiki_list .item_price { position: absolute; width: calc(100% - 0.6em); bottom: 0.3em; }

.catawiki_list img { max-height: 160px; width: auto; }

@-webkit-keyframes anim_widget { 
  0% { transform: translateX(0%); opacity: 0; }
  4% { transform: translateX(0%); opacity: 1; }
  28% { transform: translateX(0%); opacity: 1; }
  32% { transform: translateX(0%); opacity: 0; }
  33% { transform: translateX(-100%); opacity: 0; }
  37% { transform: translateX(-100%); opacity: 1; }
  61% { transform: translateX(-100%); opacity: 1; }
  65% { transform: translateX(-100%); opacity: 0; }
  66% { transform: translateX(-200%); opacity: 0; }
  70% { transform: translateX(-200%); opacity: 1; }
  94% { transform: translateX(-200%); opacity: 1; }
  98% { transform: translateX(-200%); opacity: 0; }
}

@keyframes anim_widget { 
  0% { transform: translateX(0%); opacity: 0; }
  4% { transform: translateX(0%); opacity: 1; }
  28% { transform: translateX(0%); opacity: 1; }
  32% { transform: translateX(0%); opacity: 0; }
  33% { transform: translateX(-100%); opacity: 0; }
  37% { transform: translateX(-100%); opacity: 1; }
  61% { transform: translateX(-100%); opacity: 1; }
  65% { transform: translateX(-100%); opacity: 0; }
  66% { transform: translateX(-200%); opacity: 0; }
  70% { transform: translateX(-200%); opacity: 1; }
  94% { transform: translateX(-200%); opacity: 1; }
  98% { transform: translateX(-200%); opacity: 0; }
}

.adult:not(.show-adult) img, img.adult:not(.show-adult) { filter: blur(0.3em); }

.success_message { float: right; margin-right: 1em; padding: 0.3em; background-color: lightgreen; border-radius: 0.5em; display: inline-block; min-width: 150px; text-align: center; }

.relation_graph { border-collapse: collapse; width: 100%; }

.relation_graph td { text-align: center; position: relative; }

.relation_graph tr:first-child { border-top: 1px solid black; }

.relation_graph td { border-left: 1px solid black; border-right: 1px solid black; }

.super_line { position: relative; }

.super_line h2 { border: 2px solid black; padding: 10px; display: inline-block; margin-top: 1em; margin-bottom: 1em; z-index: 2; background-color: white; }

.super_line h2::before, .super_line h2::after { content: ""; position: absolute; width: 2px; background-color: black; z-index: 0; }

.super_line h2::before { top: 0px; bottom: calc(100% - 1em); left: 50%; transform: translateX(-50%); }

.super_line h2::after { top: calc(100% - 1em); bottom: 0px; left: 50%; transform: translateX(-50%); }

.properties_menu { background: rgb(223, 238, 251); padding: 1em; border-radius: 0.5em; margin: 0px 0px 1em; box-sizing: border-box; word-break: break-word; }

.properties_menu div { text-align: center; color: grey; }

.properties_block { display: grid; grid-template-columns: auto 16em; row-gap: 1em; min-width: 400px; }

.properties_edit { display: grid; grid-template-columns: 7em auto; row-gap: 0.2em; }

.properties_edit_field { width: 90%; }

.countries_container { width: 100%; box-sizing: border-box; padding: 10px; margin-bottom: 10px; }

.add_new_form_container { margin-top: 0.5em; }

.hover_hand { cursor: pointer; padding: 0px 0.1em; }

.blurred { filter: blur(5px); transition: filter 0.3s; }

.must_fill { color: red; font-weight: bold; }

@media (min-width: 801px) {
  .countries_container { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
}

@media (max-width: 800px) {
  .properties_block { grid-template-columns: 1fr; }
  .properties_menu { grid-row: 1; margin: 0px auto 1em; width: 100%; }
  .properties_edit_field { width: calc(100% - 0.5em); margin-right: 0.5em; }
  .country_item { width: 100%; }
}

.country_intro { margin: 0.5em 0px 1em; overflow: hidden; position: relative; transition: max-height 1s ease-out; }

.country_intro_ellipsis { background: white; color: rgb(0, 0, 136); position: absolute; right: 0px; top: 1.4em; font-size: 0.9em; font-weight: normal; padding: 0px 0.5em 0.1em; }

.country_intro_ellipsis::before { content: " "; display: block; background-image: url("data:image/png;base64,"); width: 30px; height: 1.3em; position: absolute; top: 0.2em; left: -31px; }

.select2-results__option .level2 { display: block; padding-left: 1em; }

.select2-results__option .level3 { display: block; padding-left: 2em; }

.select2-results__option .level4 { display: block; padding-left: 3em; }

.select2-results__option .level5 { display: block; padding-left: 4em; }

.backoffice_buttons { padding: 0px 0.1em; opacity: 0.5; margin: 0.1em; }

.translated_info img { width: 1em; vertical-align: middle; margin: 0px 0px 0px 0.5em; cursor: pointer; }

.translated_details { background: rgb(240, 240, 240); border-radius: 0.5em; padding: 0.5em; margin: 0.5em 0px 0.5em -0.5em; max-width: max-content; }

.translated_details[aria-hidden="true"] { display: none; }

.translated_details_intro { font-style: italic; margin: 0px 0px 0.3em; }

.collection_fields_selector { display: flex; align-items: center; gap: 20px; }

.available_fields, .selected_fields { display: flex; flex-direction: column; }

.collection_fields { width: 150px; height: 120px; }

.fields_selector_controls { display: flex; flex-direction: column; gap: 10px; }

.available_fields h4, .selected_fields h4 { margin: 0px 0px 0.3rem; }

.confirmation_popup { position: absolute; line-height: 1.3em; padding: 0.5em; text-align: center; background: rgb(223, 238, 251); color: black; border-radius: 0.5em; box-shadow: rgb(170, 170, 170) 2px 2px 3px; display: none; font-size: smaller; opacity: 1; transition: opacity 3s ease-in-out; z-index: 100000; }

.collectible_types { position: relative; width: 15rem; }

.collectible_types_select_button { display: block; width: 100%; box-sizing: border-box; background: rgb(255, 255, 255); color: rgb(0, 0, 0); text-align: left; font-weight: normal; padding: 0.2em 0.5em; border: 1px solid rgb(0, 0, 136); border-radius: 0.5em; position: relative; }

.collectible_types_select_button::after { content: ""; border-color: rgb(136, 136, 136) transparent transparent; border-style: solid; border-width: 5px 4px 0px; height: 0px; right: 0.4em; margin-left: -4px; margin-top: -2px; position: absolute; top: 50%; width: 0px; }

.collectible_types_select_button[aria-pressed="true"] { border-radius: 0.5em 0.5em 0px 0px; }

.collectible_types_select { position: absolute; left: 0px; top: 100%; width: 100%; box-sizing: border-box; z-index: 10; background: rgb(255, 255, 255); border-width: medium 1px 1px; border-style: none solid solid; border-color: currentcolor rgb(0, 0, 136) rgb(0, 0, 136); border-image: none; border-radius: 0px 0px 0.5em 0.5em; padding: 0.2em 0.5em; margin: 0px; overflow: auto; }

.collectible_types_select[aria-hidden="true"], .collectible_types_select [aria-hidden="true"] { display: none; }

.collectible_types_select li { margin: 0px; padding: 0.1em 0px; list-style-type: none; }

.collectible_types_select button { margin: -0.1em -0.3em -0.1em 0px; padding: 0.1em 0.3em; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.collectible_types_select input[type="checkbox"], .collectible_types_select input[type="radio"] { vertical-align: middle; margin-bottom: 0.3em; }

.collectible_types_select ul { margin-left: 1em; list-style-type: none; }

.collectible_types_select > li.collectible_types_select_all { border-bottom: 1px solid rgb(170, 170, 170); padding-bottom: 0.3em !important; margin-bottom: 0.3em !important; }

@media (max-width: 600px) {
  .catalogue_search .collectible_types { width: unset; }
  .catalogue_search select { width: 100%; }
  .search_box .catalogue_search_input_wrapper { margin: 0px !important; max-width: none !important; }
  .catalogue_search .search_box input[type="text"] { margin: 0.5em 0px; padding: 0.2em 3.8em 0.2em 0.5em; }
  .search_box #special_keyboard_button { top: 0.7em !important; }
  .search_box .catalogue_search_input_wrapper > img { top: 0.9em !important; }
  .catalogue_search .search_box input[type="submit"] { width: 100%; margin-top: 0.5em; }
}

@media (min-width: 601px) {
  .catalogue_search .collectible_types { width: unset; }
  .catalogue_search .search_box { display: grid; grid-template-columns: 15em minmax(auto, 30em) fit-content(10em); gap: 0.5em; }
  .catalogue_search #search_types_select_all { display: none; }
  .catalogue_search #search_types { grid-area: 2 / 1 / auto / span 3; }
  .catalogue_search .collectible_types_select_button { display: none; }
  .catalogue_search .collectible_types_select { position: static; display: flex; flex-wrap: wrap; gap: 0.5em; width: auto; box-sizing: content-box; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 0px; padding: 0px; overflow: visible; }
  .catalogue_search .collectible_types_select > li { display: inline-block; position: relative; background: rgb(255, 255, 255); padding: 0.2em 0.5em 0.1em; border-radius: 0.5em; border: 1px solid rgb(0, 0, 136); }
  .catalogue_search .collectible_types_select > li > ul { position: absolute; left: -1px; top: -1px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.5) 1px 2px 0.5em 0px; padding: 1.8em 0.5em 0.2em; margin: 0px; border-radius: 0.5em; border: 1px solid rgb(0, 0, 136); z-index: 1; width: max-content; }
  .catalogue_search .collectible_types_select > li:has(> button[aria-pressed="true"]) > label, .catalogue_search .collectible_types_select > li:has(> button[aria-pressed="true"]) > button { position: relative; z-index: 2; }
}

.catalogue_search .collectible_types_select > li#cookie_setter { position: unset !important; background: unset !important; padding: unset !important; border: unset !important; }

@media (max-width: 600px) {
  .catalogue_search .search_box .select2-container { width: 100% !important; }
  .catalogue_search .collectible_types_select > li#cookie_setter { display: none; float: right; }
  .catalogue_search .collectible_types_select > li#cookie_setter.link_style { display: unset; color: rgb(0, 109, 168); cursor: pointer; }
  .catalogue_search .collectible_types_select > li#cookie_setter.saved_style { display: unset; color: unset; text-decoration: unset; cursor: unset; }
}

@media (min-width: 601px) {
  .catalogue_search .collectible_types_select > li#cookie_setter { display: none; align-self: center; }
  .catalogue_search .collectible_types_select > li#cookie_setter.link_style { display: unset; color: rgb(0, 109, 168); cursor: pointer; }
  .catalogue_search .collectible_types_select > li#cookie_setter.saved_style { display: unset; color: unset; text-decoration: unset; cursor: unset; }
}
