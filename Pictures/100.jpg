@media (max-width: 700px) {
  .vos_pieces_date, .vos_pieces_quantite, .vos_pieces_comments, .vos_pieces_header, .vos_pieces_header th { display: block; }
  .vos_pieces_quantite label abbr, .vos_pieces_quantite .label abbr, .vos_pieces_quantite label span, .vos_pieces_quantite .label span { display: none; }
  .vos_pieces_header th { color: rgb(102, 102, 102); text-align: left; }
  .vos_pieces_quantite label, .vos_pieces_quantite .label, .vos_pieces_header abbr { display: inline-block; width: 2em; text-align: center; margin: 0px; }
  .vos_pieces_quantite label.vos_pieces_quantite_echange, .vos_pieces_header span { display: inline-block; width: 3em; text-align: center; margin: 0px; }
  .vos_pieces_comments { padding-left: 0px; }
}

#vos_pieces th, #voir_collections th, #swaplist .swaplist_issuer, #my_coins_gallery .my_coins_country { padding-top: 2em; text-align: left; color: rgb(0, 0, 136); border-bottom: 2px solid rgb(0, 0, 136); font-weight: bold; }

#vos_pieces .currency_sep, #voir_collections .currency_sep, #swaplist .swaplist_chapter, #my_coins_gallery .my_coins_chapter { font-weight: bold; color: rgb(0, 0, 136); padding: 1em 0px 0px; }

#vos_pieces .currency_sep.first_currency, #voir_collections .currency_sep.first_currency, #swaplist .swaplist_chapter.first_chapter, #my_coins_gallery .my_coins_chapter.first_chapter { padding-top: 0.3em; }

#my_coins_gallery { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 1em 2em; clear: both; }

#my_coins_gallery .my_coins_country { grid-column: 1 / -1; padding-top: 1em; }

#my_coins_gallery .my_coins_chapter { grid-column: 1 / -1; }

#my_coins_gallery .my_coins_chapter.first_chapter { margin-top: -1em; }

#my_coins_gallery .my_coins_type { margin-bottom: 0.8em; flex-direction: column; }

#my_coins_gallery .my_coins_pictures { display: block; white-space: nowrap; overflow: auto; }

#my_coins_gallery .my_coins_pictures img { max-width: 50%; }

#my_coins_gallery .catalogue_pic { filter: grayscale(1) opacity(0.5); }

#my_coins_gallery .my_coins_count { float: right; border-radius: 0.6em; padding: 0px 0.4em; margin-left: 0.2em; font-weight: bold; font-variant-numeric: tabular-nums; }

#my_coins_gallery .my_coins_button ~ div { position: relative; }

#my_coins_gallery .my_coins_button ~ div::before { background-color: aliceblue; z-index: 3; box-shadow: rgba(178, 178, 178, 0.4) -2px -2px 2px 0px; content: "Â "; display: block; height: 20px; position: absolute; left: 3em; top: 0.5em; transform: rotate(45deg); width: 20px; }

#my_coins_gallery .hidden_details ~ div, #my_coins_gallery .hidden_details ~ table { display: none; }

#my_coins_gallery table { position: absolute; margin-top: 1em; left: 0.5em; z-index: 1; width: calc(100% - 1em); background: aliceblue; box-shadow: rgb(178, 178, 178) 0px 0px 8px; }

#my_coins_gallery .vos_pieces_date, #my_coins_gallery .vos_pieces_quantite, #my_coins_gallery .vos_pieces_comments { padding-left: 0.3em; padding-right: 0.3em; }

#my_coins_gallery .vos_pieces_type { padding: 1em 0.3em 0px; }

#my_coins_gallery tr:last-child .vos_pieces_date, #my_coins_gallery tr:last-child .vos_pieces_quantite, #my_coins_gallery tr:last-child .vos_pieces_comments { padding-bottom: 0.5em; }

@media (max-width: 1200px) {
  #my_coins_gallery { grid-template-columns: 1fr 1fr 1fr; margin: 0px -0.5em; column-gap: 1.5em; }
}

@media (max-width: 650px) {
  #my_coins_gallery { grid-template-columns: 1fr 1fr; margin: 0px -0.5em; column-gap: 1.5em; }
  #my_coins_gallery .my_coins_country, #my_coins_gallery .my_coins_chapter { margin-left: -0.5em; margin-right: -0.5em; padding-left: 0.5em; padding-right: 0.5em; }
  #my_coins_gallery table { width: 100%; left: 0px; }
  #my_coins_gallery tr:last-child .vos_pieces_date, #my_coins_gallery tr:last-child .vos_pieces_quantite, #my_coins_gallery tr:last-child .vos_pieces_comments { padding-bottom: 0px; }
  #my_coins_gallery .vos_pieces_comments { padding-bottom: 0.5em !important; }
}

@media (max-width: 400px) {
  #my_coins_gallery { grid-template-columns: 1fr; }
}

.color0 { background-color: rgb(141, 211, 199); }

.color1 { background-color: rgb(255, 255, 179); }

.color2 { background-color: rgb(190, 186, 218); }

.color3 { background-color: rgb(251, 128, 114); }

.color4 { background-color: rgb(128, 177, 211); }

.color5 { background-color: rgb(253, 180, 98); }

.color6 { background-color: rgb(179, 222, 105); }

.color7 { background-color: rgb(252, 205, 229); }

.color8 { background-color: rgb(217, 217, 217); }

.color9 { background-color: rgb(188, 128, 189); }

.color10 { background-color: rgb(204, 235, 197); }

.color11 { background-color: rgb(255, 237, 111); }

.default_color { background-color: rgb(223, 238, 251); color: rgb(0, 0, 136); }

#collec_journal details { padding-bottom: 0.3em; }

#collec_journal details[open] summary ~ * { animation: 0.3s ease-in-out 0s 1 normal none running journal_sweep; margin-left: 2em; }

@keyframes journal_sweep { 
  0% { opacity: 0; margin-left: 1em; }
  100% { opacity: 1; margin-left: 2em; }
}

#collec_journal summary { display: flex; }

summary { cursor: pointer; }

summary::marker { display: none; content: ""; }

summary::-webkit-details-marker { display: none; content: ""; }

details summary::before { content: "â–¶"; margin-right: 0.5em; }

details[open] > summary::before { content: "â–¼"; }

#collec_journal em { min-width: 8em; font-style: normal; }

#collec_journal strong { min-width: 16em; }

#collec_journal a { margin-right: 0.5em; }

#collec_journal p.intro { margin: 0px; }

#collec_journal table { margin-bottom: 1em; border-collapse: collapse; }

#collec_journal th { text-align: left; }

#collec_journal th, #collec_journal td { padding-right: 1em; }

#collec_journal_picker { margin: 0.5em 0px 2em; background: rgb(223, 238, 251); border-radius: 0.5em; padding: 1em; }

#collec_journal_picker input[type="text"] { width: 8em; padding: 0.2em; margin-bottom: 0.2em; }

@media (max-width: 600px) {
  #collec_journal summary { display: block; margin-top: 0.5em; }
  #collec_journal summary > em { display: inline-block; }
  #collec_journal summary > span { display: block; }
}

.picture_list { display: flex; flex-wrap: wrap; margin-right: -1em; }

.picture_list > div { border: 1px solid rgb(172, 210, 245); border-radius: 1em; padding: 1em; margin-bottom: 1em; margin-right: 1em; box-sizing: border-box; width: calc(20% - 1em); position: relative; }

@media (max-width: 1200px) {
  .picture_list > div { width: calc(25% - 1em); padding: 0.5em; }
}

@media (max-width: 680px) {
  .picture_list > div { width: calc(33% - 1em); padding: 0.5em; }
}

@media (max-width: 500px) {
  .picture_list > div { width: calc(50% - 1em); padding: 0.5em; }
}

@media (max-width: 320px) {
  .picture_list > div { width: calc(100% - 1em); }
}

.picture_list button { position: absolute; top: -0.5rem; right: 0px; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; font-weight: bold; padding: 0.5rem; font-size: 2em; color: rgb(102, 102, 102); }

.picture_list button:hover, .picture_list button:focus { color: black; }

.picture_list img { cursor: zoom-in; }

#wish_config { list-style-type: none; }

#wish_config li { margin: 0px; padding: 0px 0px 0.5em 2em; text-indent: -2em; }

#wish_config::before { content: " "; display: block; float: right; margin: 0px 0px 1em 1em; background: url("wish-choices.png"); width: 86px; height: 76px; }

#wish_config.wish_config_combine::before { background-position: 0px 0px; }

#wish_config.wish_config_restrictif::before { background-position: 0px -76px; }

#wish_config.wish_config_veux::before { background-position: 0px -152px; }

#wish_config.wish_config_manque::before { background-position: 0px -228px; }

.form_souhait { margin-bottom: 1em; }

.collection, #vos_pieces, #voir_collections, #swaplist, #my_coins_gallery table { border-collapse: collapse; border-bottom: 1px solid aliceblue; }

.collection_old { border-collapse: collapse; }

#vos_pieces, #voir_collections, #swaplist { min-width: 90%; }

.collection tbody, .par0 { background-color: white; }

.collection tbody:nth-child(4n+2), .collection tbody:nth-child(4n+3), .par1 { background-color: aliceblue; }

.collection, .collection_old { clear: right; }

.collection .date_row td { vertical-align: middle; }

.collection td { vertical-align: top; }

.collection th, .collection_old th { position: sticky; top: 0px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.4) 0px 1px 1px -1px; padding: 0.3em 0px; z-index: 10; }

.collection th.value { padding-left: 0.5em; padding-right: 0.5em; }

.collection th.date { text-align: left; padding-left: 0.5em; }

.collection td.date { white-space: nowrap; padding: 0.3em 0px 0.3em 0.5em; }

.date_row td { padding-left: 0.3em; }

.collection td.tirage { text-align: right; padding: 0px 0.5em; }

.collection td.sign { white-space: nowrap; }

.mark { max-width: 1.3em; max-height: 1.3em; vertical-align: middle; }

.collection td.pic > img { max-width: none; }

.collection td.quantite { text-align: center; vertical-align: middle; }

.collection td.value { min-width: 2em; text-align: center; padding: 0px 0.5em; white-space: nowrap; }

.collection .value:empty::before { content: "-"; color: rgb(119, 119, 119); }

.collection td.references { padding: 0px 0.5em; }

.collection td.comment { padding-right: 0.5em; word-break: break-word; }

.collec td:last-child { white-space: nowrap; }

.collec td:first-child { padding-left: 4em; white-space: normal; }

.collec td > span::before, .collec button span, .collec_add span { content: " "; vertical-align: middle; display: inline-block; height: 16px; background-image: url("icons-sprite36.png"); margin: 0px 0.2em 0.2em 0.5em; }

.collec .collec_q { font-size: 1.2em; font-weight: bold; color: rgb(0, 0, 136); }

.collec .collec_q::before, .collec .collec_section::before, #swaplist .collec .collec_q::before { display: none; }

.collec .collec_swap::before { margin-right: 0.2em; content: url("icones/swap.svg"); position: relative; top: 2px; }

.collec .collec_slab::before { margin-right: 0.2em; content: url("icones/slab.svg"); position: relative; top: 2px; }

.collec .collec_measure::before { margin-right: 0.2em; content: url("icones/measure.svg"); position: relative; top: 2px; }

.collec .collec_serial::before { margin-right: 0.2em; content: url("icones/serial_number.svg"); position: relative; top: 3px; }

.collec .collec_internal::before { margin-right: 0.2em; content: url("icones/identifier.svg"); position: relative; top: 2px; }

.collec .collec_storage::before { margin-right: 0.2em; content: url("icones/storage.svg"); position: relative; top: 2px; }

.collec .collec_price::before { margin-right: 0.2em; content: url("icones/acquisition.svg"); position: relative; top: 2px; }

.collec .collec_comment::before { margin-right: 0.2em; content: url("icones/private_comment.svg"); position: relative; top: 2px; }

.collec .collec_swap_comment { word-break: break-word; }

.collec .collec_swap_comment::before { margin-right: 0.2em; content: url("icones/public_comment.svg"); position: relative; top: 2px; }

.collec_pictures::before { margin-right: 0.2em; content: url("icones/picture.svg"); position: relative; top: 2px; }

.recap_echange .collec_pictures::before { margin: 0px 0.5em 0.2em 0px; }

.collec .collec_section { display: inline-block; margin: 0px 0.5em 0px 0px; padding: 0.2em 0.4em; border-radius: 0.8em; min-width: 0.8em; height: 1.2em; white-space: nowrap; text-align: center; cursor: default; }

.collec .collec_section em { display: inline-block; vertical-align: bottom; max-width: 0px; overflow: hidden; font-style: normal; transition: max-width 2s; }

.collec .collec_section:hover em { max-width: 50em; }

.collec button span, .collec_add span { margin: 4px; }

.collec button, .collec_add { background-color: transparent; border: 1px solid rgb(172, 210, 245); border-radius: 0.4em; padding: 0px; margin: 0.2em 0.2em 0.2em 0.5em; }

.collec button:hover, .collec_add:hover { background-color: rgb(223, 238, 251); }

.collec .collec_edit span { width: 16px; background-position: -79px -134px; }

.collec .collec_delete span { width: 16px; background-position: -47px -134px; }

.collec_add span { width: 16px; background-position: -63px -134px; }

.collec_admin { padding-left: 4rem; font-size: 80%; }

#collec_form { display: table; }

#collec_form > div { display: table-row; }

#collec_form .form_name, #collec_form .form_value { display: table-cell; padding-bottom: 0.5em; }

@media (max-width: 480px) {
  #collec_form { display: block; }
  #collec_form > div { display: block; }
  #collec_form .form_name, #collec_form .form_value { display: block; padding-bottom: 0.5em; }
  #collec_form .form_name br { display: none; }
  #collec_form .form_name { padding-bottom: 0px; }
}

#collec_form .form_name { padding-right: 0.5em; vertical-align: middle; }

#collec_form input[type="radio"] { position: absolute; z-index: -1; }

#collec_form input[type="radio"] + label { display: inline-block; border: 1px solid rgb(0, 0, 136); border-radius: 0.3em; min-width: 2em; text-align: center; cursor: pointer; margin-right: 0.5em; background: white; color: black; user-select: none; }

#collec_form input[type="radio"] + label:last-child { margin-right: 0px; }

#collec_form input[type="radio"] + label abbr { cursor: pointer; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

#collec_form input[type="radio"]:checked + label { background: rgb(0, 0, 136); color: rgb(255, 255, 255); }

#collec_form input[type="radio"]:focus + label { outline: rgb(77, 144, 254) auto 5px; outline-offset: -2px; }

#collec_form input[type="text"] { display: block; width: 100%; box-sizing: border-box; }

#collec_form input[type="number"] { width: 4em; }

#collec_form input:invalid { color: red; }

.collec_form_submit { text-align: center; }

.collec_form_submit input { min-width: 10em; margin: 0px 1em 1em 0px; }

@media only screen and (max-width: 1200px) {
  #vos_pieces, #voir_collections { margin: 0px -1em; }
  #vos_pieces td:first-child, #vos_pieces th:first-child, #voir_collections td:first-child, #voir_collections th:first-child, #my_coins_gallery table td:first-child { padding-left: 0.5em; }
  #vos_pieces td:last-child, #voir_collections td:last-child, #my_coins_gallery table td:last-child { padding-right: 0.5em; }
  .collection { display: block; margin: 0px -1em; }
  .collection::after { content: ""; clear: left; display: block; }
  .collection tbody { display: block; padding: 0.2em 0px; overflow: auto; }
  .collection tbody::-webkit-scrollbar { display: none; }
  .collection th { display: none; }
  .collection tr { display: grid; }
  .collection td { display: block; align-self: center; }
  .collection .date { grid-column: 1 / span 1; }
  .collection .tirage { grid-row-start: 1; grid-column: 3 / span 2; }
  .collection .tirage:not(:empty)::after { content: " ex."; }
  .collection .btn_collec { grid-row-start: 1; grid-column: 7 / span 1; text-align: right; padding-right: 0.2em; }
  .collection .value { grid-row-start: 3; grid-column-end: span 1; align-self: end; }
  .collection .value:not(:empty)::before { display: block; content: attr(data-grade); color: rgb(119, 119, 119); }
  .collection .references { grid-row-start: 2; grid-column: 1 / span 2; }
  .collection .comment { grid-row-start: 2; grid-column: 3 / span 5; font-style: italic; padding: 0px 0.5em; }
  .collection .no_references { display: none; }
  .collection .no_references ~ .comment { grid-column-start: 1; }
  .collection .own_stat { grid-row-start: 1; grid-column: 6 / span 1; }
  .collection .collec tr { display: grid; grid-template-columns: auto 80px; }
  .collec_admin { grid-column: 1 / span 7; }
}

@media only screen and (max-width: 350px) {
  .collec_form_submit input:first-child { margin-bottom: 1em; }
}

.collection_old td { vertical-align: top; }

.collection_old td.date { white-space: nowrap; }

.collection_old .tirage { padding: 0px 0.5em; text-align: right; }

.collection_old td.quantite { text-align: center; }

.collection_old .quantite > input, .collection_old .quantite div, .quantites_pieces input, .quantites_pieces input[type="number"] { display: inline-block; position: relative; border-width: 1px; border-style: solid; border-color: rgb(102, 102, 102) rgb(136, 136, 136) rgb(136, 136, 136) rgb(102, 102, 102); height: 1.3rem; padding: 0px; text-align: center; background: white; overflow: hidden; width: 1.8rem !important; }

.collection_old .quantite div input { border: 0px; width: 100%; text-align: center; }

.collection_old input::-webkit-outer-spin-button, .collection_old input::-webkit-inner-spin-button, .quantites_pieces input::-webkit-inner-spin-button { appearance: none; margin: 0px; }

.collection_old td.btn_comm_perso { text-align: center; }

.collection_old .btn_comm_perso img { vertical-align: bottom; max-width: none; }

.collection_old td.own_stat { text-align: center; }

.collection_old td.comments { width: 100%; word-break: break-word; }

@media (max-width: 650px) {
  .collection_old { display: block; border: 1px solid rgb(223, 238, 251); border-collapse: collapse; }
  .collection_old::after { content: ""; display: block; clear: left; }
  .collection_old tbody { display: block; }
  .collection_old tr { display: block; float: left; clear: left; width: 100%; box-sizing: border-box; padding: 0.2em 0.5em; }
  .collection_old tr:nth-child(2n) { background: rgb(223, 238, 251); }
  .collection_old tr:nth-child(2n+1) { background: rgb(248, 248, 248); }
  .collection_old td, .collection_old th { display: block; float: left; }
  .collection_old th.date, .collection_old th.tirage, .collection_old th.own_stat { display: none; }
  .collection_old td.date { font-weight: bold; }
  .collection_old td.tirage:not(:empty)::after { content: " ex."; }
  .collection_old td.quantite:nth-child(3) { clear: left; }
  .collection_old .quantite { width: 2em; }
  .collection_old .quantite_echange { width: 4em; }
  .collection_old .own_stat { padding-left: 0.5em; }
}

.modal { position: fixed; z-index: 1000; left: 0px; top: 0px; width: 100%; height: 100%; overflow: auto; background-color: rgba(0, 0, 0, 0.4); }

.modal-container { background-color: rgb(254, 254, 254); border: 1px solid rgb(136, 136, 136); border-radius: 1em; max-width: 80%; margin: 2em auto; position: relative; display: flex; flex-direction: column; }

.modal header { background: rgb(223, 238, 251); padding: 0.7em 3em 0.7em 1em; border-radius: 1em 1em 0px 0px; color: rgb(0, 0, 136); font-weight: bold; }

.modal .modal-body { padding: 1em; overflow: auto; max-width: 60em; }

.modal select { max-width: 20em; padding: 0.2em 0px; }

input[type="button"].close { color: rgb(0, 0, 0); background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; position: absolute; top: 0.5rem; right: 0.5em; padding: 0px; font-size: 2em; font-weight: bold; }

input[type="button"].close:hover, input[type="button"].close:focus { color: black; text-decoration: none; cursor: pointer; }

.collec_modal .modal-container { width: 30em; }

.collec_modal .modal-body { padding-bottom: 0px; }
