a { color: rgb(0, 109, 168); text-decoration: none; }

a:visited { color: rgb(102, 0, 238); }

a:hover { text-decoration: underline; }

a.external_link::after { content: ""; display: inline-block; width: 16px; height: 16px; background-image: url("/design/icones/link.svg"); background-repeat: no-repeat; margin: 0px 0px -2px 5px; }

ol { padding-left: 1em; }

li { margin: 0px 0px 0px 17px; }

img { max-width: 100%; height: auto; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

img.icone { vertical-align: -2px; max-width: none; }

abbr { border-bottom: 1px dotted rgb(172, 203, 65); text-decoration: none; cursor: help; }

