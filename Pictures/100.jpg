@charset "utf-8";

#dashboard_filters { text-align: right; margin: 0px 0px 1em; }

#dashboard_filters { text-align: right; margin: 0px 0px 1em; }

#dashboard_filters * { text-align: left; }

#dashboard_filters label { display: inline-block; vertical-align: bottom; padding-bottom: 0.3em; }

@media (min-width: 650px) {
  #dashboard_filters { text-align: right; margin: -3.5em 0px 1.5em; }
}

#dashboard_figures { display: table; border-spacing: 0.2em; margin: 0px auto 1em; table-layout: fixed; }

#dashboard_figures div { width: 16.66%; display: table-cell; border: 1px solid rgb(172, 210, 245); border-radius: 1em; padding: 0.3em; text-align: center; vertical-align: middle; }

@media (max-width: 440px) {
  #dashboard_figures { display: flex; flex-flow: wrap; justify-content: center; margin-bottom: 0.5em; }
  #dashboard_figures div { display: flex; flex-direction: column; justify-content: center; max-width: 5em; width: auto; margin: 0px 0.2em 0.5em; }
}

#dashboard_figures span { display: block; font-weight: bold; }

#collection_country_select span { white-space: nowrap; }

#collection_country_select select { border: 1px solid rgb(102, 102, 102); border-radius: 0.5em; width: 17em; }

#collection_country_select input { background: rgb(0, 0, 136); color: white; font-weight: bold; padding: 0.2em 0.3em; border: 1px solid rgb(0, 0, 136); border-radius: 0.5em; }

.select2-dropdown { min-width: 250px; }

.select2-container--default .select2-results > .select2-results__options { max-height: 250px; }

.select2-results__option { margin: 0px; padding: 3px !important; }

.select2-results__option[aria-disabled="true"] { color: rgb(102, 102, 102) !important; font-style: italic; }

.select2-results__message { font-style: italic; }

.select2-results__option .level2 { display: block; padding-left: 1em; }

.select2-results__option .level3 { display: block; padding-left: 2em; }

.select2-results__option .level4 { display: block; padding-left: 3em; }

.select2-results__option .level5 { display: block; padding-left: 4em; }

.select2-results__option .historical_period { font-style: italic; }

#dashboard_charts { display: grid; grid-template-columns: auto auto auto; text-align: center; column-gap: 1em; }

#dashboard_charts h3 { margin: 1em 0px 0.3em; }

#dashboard_charts .dashboard_chart_legend { display: flex; }

#dashboard_charts .dashboard_chart_container { width: 6em; padding-right: 0.5em; }

#dashboard_charts table { text-align: left; font-size: 0.9em; border-collapse: collapse; margin: 0px auto; }

#dashboard_charts td { vertical-align: top; }

#dashboard_charts #metals_legend, #dashboard_charts #coin_types_legend { max-height: 10em; overflow: auto; }

svg > g > g.google-visualization-tooltip { pointer-events: none; }

#metals_legend { overflow-y: scroll; }

.chart_legend .color span { display: inline-block; width: 1em; height: 1em; margin: 0px 0.5em -0.1em 0px; border-radius: 0.3em; }

.chart_legend .label { padding-right: 0.5em; }

.chart_legend .value { text-align: right; padding-right: 0.3em; }

.chart_legend tr[onclick] { cursor: pointer; }

.chart_legend tr[onclick]:hover { text-decoration: underline; }

#dashboard_total_weight { display: inline-block; text-align: center; margin-bottom: 0.5em; }

#dashboard_total_weight strong { display: block; }

#dashboard_total_weight img { float: left; }

#dashboard_weight td:nth-child(1) { text-align: left; }

#dashboard_weight td:nth-child(2) { text-align: right; padding-left: 0.5em; white-space: nowrap; }

#dashboard_weight td:nth-child(3) { text-align: right; padding-left: 0.5em; color: rgb(102, 102, 102); white-space: nowrap; }

#dashboard_records td:first-child { padding-right: 0.5em; }

#dashboard_records div { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 10em; }

#dashboard_history, #dashboard_years { margin: 2em 0px 1em; }

#dashboard_history h3, #dashboard_years h3 { text-align: center; margin: 1em 0px 0px; }

#dashboard_history > div, #dashboard_years > div { height: 18em; }

@media (max-width: 820px) {
  #dashboard_charts { grid-template-columns: auto auto; }
  #dashboard_charts { text-align: left; }
  #dashboard_charts table { margin-left: 0px; }
}

@media (max-width: 600px) {
  #dashboard_charts { grid-template-columns: auto; }
}

#cadre_carte { position: relative; text-align: center; margin: 30px 0px 5px; }

#cadre_carte #chargement_carte { position: absolute; width: 10em; margin: 5em auto 0px; left: 0px; right: 0px; padding: 5px; border: 1px solid black; background: white; text-align: center; box-shadow: rgb(170, 170, 170) 3px 3px 8px; }

#cadre_carte #chargement_carte img { margin: 0px 5px -3px 0px; }

#infobulles div { position: absolute; display: none; padding: 0.5em; background: rgb(223, 238, 251); border-radius: 0.5em; box-shadow: rgb(170, 170, 170) 2px 2px 3px; text-align: left; font-size: 90%; z-index: 100000; max-height: 10.5em; overflow-y: auto; }

#map_legend { text-align: right; }

#map_legend input[type="radio"] { visibility: hidden; display: block; position: absolute; }

#map_legend label { display: inline-block; width: 5em; line-height: 1.3em; padding: 0.2em; text-align: center; border: 1px solid rgb(172, 210, 245); user-select: none; cursor: pointer; color: rgb(0, 0, 136); font-size: 0.9em; vertical-align: bottom; }

#map_legend label:nth-child(2) { border-radius: 0.5em 0px 0px 0.5em; border-right-width: medium; border-right-style: none; border-right-color: currentcolor; }

#map_legend label:nth-child(4) { border-radius: 0px 0.5em 0.5em 0px; }

#map_legend input:checked + label { background: rgb(223, 238, 251); font-weight: bold; }

#map_legend input[type="submit"] { padding: 0.2em 0.5em; margin-left: 0.5em; border: 1px solid rgb(172, 210, 245); border-radius: 0.5em; background: white; color: rgb(0, 0, 136); font-size: 0.9em; cursor: pointer; }

#map_legend input[type="submit"]:hover { background: rgb(223, 238, 251); }

