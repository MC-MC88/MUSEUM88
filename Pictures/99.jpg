@charset "utf-8";

@media (min-width: 1200px) {
  #help_list { column-count: 2; column-gap: 4em; }
  #help_list > div { display: inline-block; margin: 0px 0px 1em; width: 100%; }
  #help_page_search { max-width: calc(50% - 2em); }
}

#help_list h3 { font-size: 1.1em; margin-top: 0px; }

#help_list ul { list-style-type: none; border-bottom: 1px solid rgb(204, 204, 204); margin-bottom: 1.5em; }

#help_list li { padding: 0.5em 0px; margin: 0px; border-top: 1px solid rgb(204, 204, 204); }

#help_highlights { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1em; margin: 0px -0.5em; }

#help_highlights > a { border-radius: 0.5em; background: rgb(224, 238, 251); padding: 0.5em; }

#help_highlights strong { display: block; margin-bottom: 0.3em; }

#help_highlights em { display: block; color: rgb(0, 0, 0); text-decoration: underline rgb(224, 238, 251); }

@media (max-width: 500px) {
  #help_highlights { grid-template-columns: 1fr; }
}

.help_search_bar { display: flex; margin: 2em 0px; max-width: 50em; }

.help_search_bar input[type="text"] { flex: 1 1 0%; margin-right: 0.5em; }

#help_page_search { margin: 1em 0px; }

#help_search_results { max-width: 50em; }

#help_search_results > div { margin-bottom: 1em; }

#help_search_results a { font-weight: bold; }

.guidelines_example { list-style-type: "âœ“  "; }

.guidelines_example::marker { color: rgb(0, 136, 0); }

div.guidelines_example::before { content: "âœ“  "; color: rgb(0, 136, 0); }

.guidelines_counter_example { list-style-type: "âœ—  "; }

.guidelines_counter_example::marker { color: rgb(136, 0, 0); }

div.guidelines_counter_example::before { content: "âœ—  "; color: rgb(136, 0, 0); }
