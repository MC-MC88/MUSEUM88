.select2-container--default .select2-selection--multiple .select2-selection__clear { margin-top: 3px; }

span.select2-selection.select2-selection--single { border: 1px solid rgb(118, 118, 118); border-radius: 2px; height: 32px; }

.select2-container--default .select2-selection--single .select2-selection__rendered { padding-top: 2px; padding-left: 5px; color: rgb(0, 0, 0); }

.muted-label { color: rgb(102, 102, 102); }

.select2-results__option--highlighted .muted-label { color: rgb(240, 248, 255); }
